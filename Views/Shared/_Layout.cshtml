    <style>
            /* Toast notification container */
            .toast-notification {
                position: fixed;
                z-index: 9999;
                top: 1rem;
                right: 1rem;
                display: flex;
                flex-direction: column;
                padding: 1.5rem 1rem;
                pointer-events: none;
            }

            .toast-success-notification {
                top: 1rem;
                right: 1rem;
            }

            .toast-failed-notification {
                top: 1rem;
                right: 1rem;
            }

            /* Toast wrapper */
            .toast-wrapper {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                width: 100%;
                gap: 1rem;
            }

            /* Toast content */
            .toast-content {
                width: 100%;
                max-width: 24rem;
                overflow: hidden;
                background-color: #ffffff;
                border-radius: 0.5rem;
                box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
                border: 1px solid rgba(0, 0, 0, 0.05);
                pointer-events: auto;
                opacity: 0;
                transform: translateY(0.5rem);
                transition: opacity 300ms ease, transform 300ms ease;
            }

                /* Toast visible state */
                .toast-content.toast-visible {
                    opacity: 1;
                    transform: translate(0, 0);
                }

            /* Toast inner layout */
            .toast-body {
                display: flex;
                align-items: flex-start;
                padding: 1rem;
            }

            /* Icon */
            .toast-icon {
                flex-shrink: 0;
            }

                .toast-icon svg {
                    display: block;
                    width: 1.5rem;
                    height: 1.5rem;
                }

            .toast-success-notification .toast-icon {
                color: #4ade80;
            }

            .toast-failed-notification .toast-icon {
                color: #f87171;
            }

            /* Message */
            .toast-message {
                flex: 1;
                width: 0;
                min-width: 0;
                margin-left: 0.75rem;
                padding-top: 0.125rem;
            }

            .toast-heading {
                margin: 0;
                color: #111827;
                font-size: 0.875rem;
                font-weight: 500;
                line-height: 1.25rem;
            }

            .toast-description {
                margin: 0.25rem 0 0;
                color: #6b7280;
                font-size: 0.875rem;
                font-weight: 400;
                line-height: 1.25rem;
                overflow-wrap: break-word;
            }

            /* Close button */
            .toast-close {
                display: flex;
                flex-shrink: 0;
                margin-left: 1rem;
            }

                .toast-close button {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 0;
                    border: 0;
                    border-radius: 0.375rem;
                    background-color: #ffffff;
                    color: #9ca3af;
                    cursor: pointer;
                    transition: color 150ms ease;
                }

                    .toast-close button:hover {
                        color: #6b7280;
                    }

                    .toast-close button:focus {
                        outline: 2px solid #6366f1;
                        outline-offset: 2px;
                    }

                .toast-close svg {
                    width: 1.25rem;
                    height: 1.25rem;
                }
            /* Initial toast state */
            .toast-content {
                opacity: 0;
                transform: translateY(0.5rem);
                transition: opacity 300ms ease, transform 300ms ease;
            }

                /* Visible toast state */
                .toast-content.toast-visible {
                    opacity: 1;
                    transform: translateY(0);
                }

                /* Closing animation */
                .toast-content.toast-hiding {
                    opacity: 0;
                    transform: translateY(0.5rem);
                }
            /* Dark mode */
            @@media (prefers-color-scheme: dark) {
                .toast-content {
                    background-color: #111827;
                }

                .toast-heading {
                    color: #ffffff;
                }

                .toast-description {
                    color: #9ca3af;
                }

                .toast-close button {
                    background-color: #111827;
                    color: #9ca3af;
                }

                    .toast-close button:hover {
                        color: #d1d5db;
                    }
            }

            /* Small screens */
            @@media (max-width: 639px) {
                .toast-notification {
                    right: 0;
                    left: 0;
                    padding: 1.5rem 1rem;
                }

                .toast-wrapper {
                    align-items: center;
                }

                .toast-content {
                    max-width: 100%;
                }
            }
    </style>
</head>
<body>
