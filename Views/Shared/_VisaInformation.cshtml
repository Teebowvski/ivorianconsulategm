    <partial name="_ConsularInformationTrim" />
 
    <div class="our-faqs-section">
        <!-- Section Title Start -->
        <div class="section-title">
            <h3 class="wow fadeInUp">FAQ</h3>
            <h2 class="text-anime-style-3" data-cursor="-opaque">
                Frequently Asked Questions
            </h2>
        </div>
        <!-- Section Title End -->
        <!-- FAQ Accordion Start -->
        <div class="faq-accordion" id="faqaccordion">

            <!-- FAQ 1 -->
            <div class="accordion-item wow fadeInUp">
                <h2 class="accordion-header" id="heading1">
                    <button class="accordion-button" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse1"
                            aria-expanded="true"
                            aria-controls="collapse1">
                        Do Gambian citizens need a visa to travel to Côte d’Ivoire?
                    </button>
                </h2>
                <div id="collapse1" class="accordion-collapse collapse show"
                     aria-labelledby="heading1" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            No. Gambian citizens benefit from visa-free travel to
                            Côte d’Ivoire under ECOWAS free-movement arrangements.
                            Travellers must carry valid travel documents and comply
                            with applicable entry requirements.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 2 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                <h2 class="accordion-header" id="heading2">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse2"
                            aria-expanded="false"
                            aria-controls="collapse2">
                        Who needs a visa to enter Côte d’Ivoire?
                    </button>
                </h2>
                <div id="collapse2" class="accordion-collapse collapse"
                     aria-labelledby="heading2" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Visa requirements depend on the traveller's nationality
                            and passport type. Foreign nationals residing in The
                            Gambia should verify their visa eligibility with the
                            Consulate before making travel arrangements.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 3 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.3s">
                <h2 class="accordion-header" id="heading3">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse3"
                            aria-expanded="false"
                            aria-controls="collapse3">
                        What types of visas are available for Côte d’Ivoire?
                    </button>
                </h2>
                <div id="collapse3" class="accordion-collapse collapse"
                     aria-labelledby="heading3" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Depending on the purpose and duration of travel,
                            visa categories may include tourist, business,
                            transit, private visit, official and long-stay visas.
                            Applicants should contact the Consulate to identify
                            the appropriate visa category.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 4 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                <h2 class="accordion-header" id="heading4">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse4"
                            aria-expanded="false"
                            aria-controls="collapse4">
                        What documents are required for a visa application?
                    </button>
                </h2>
                <div id="collapse4" class="accordion-collapse collapse"
                     aria-labelledby="heading4" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Common supporting documents may include:
                        </p>
                        <ul>
                            <li>A valid passport.</li>
                            <li>A completed visa application form.</li>
                            <li>Recent passport-sized photographs.</li>
                            <li>Proof of accommodation or an invitation letter.</li>
                            <li>A flight itinerary or travel reservation.</li>
                            <li>A valid yellow fever vaccination certificate.</li>
                        </ul>
                        <p>
                            Additional documents may be required depending on
                            the purpose of travel and visa category. Please
                            confirm the specific requirements with the Consulate.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 5 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.5s">
                <h2 class="accordion-header" id="heading5">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse5"
                            aria-expanded="false"
                            aria-controls="collapse5">
                        How long must my passport be valid?
                    </button>
                </h2>
                <div id="collapse5" class="accordion-collapse collapse"
                     aria-labelledby="heading5" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Travellers are generally advised to hold a passport
                            valid for at least six months beyond their intended
                            travel date. Please confirm the applicable passport
                            validity requirements with the Consulate before
                            submitting your application.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 6 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                <h2 class="accordion-header" id="heading6">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse6"
                            aria-expanded="false"
                            aria-controls="collapse6">
                        Is yellow fever vaccination required?
                    </button>
                </h2>
                <div id="collapse6" class="accordion-collapse collapse"
                     aria-labelledby="heading6" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Yes. Travellers entering Côte d’Ivoire should carry
                            a valid international yellow fever vaccination
                            certificate. Ensure that your vaccination
                            documentation is available when travelling.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 7 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.7s">
                <h2 class="accordion-header" id="heading7">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse7"
                            aria-expanded="false"
                            aria-controls="collapse7">
                        How long does visa processing take?
                    </button>
                </h2>
                <div id="collapse7" class="accordion-collapse collapse"
                     aria-labelledby="heading7" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Visa processing times may vary depending on the
                            application category, completeness of submitted
                            documents and any additional verification required.
                            Applicants are encouraged to contact the Consulate
                            for current processing timelines and to apply well
                            ahead of their intended travel date.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 8 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                <h2 class="accordion-header" id="heading8">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse8"
                            aria-expanded="false"
                            aria-controls="collapse8">
                        How much does an Ivorian visa cost?
                    </button>
                </h2>
                <div id="collapse8" class="accordion-collapse collapse"
                     aria-labelledby="heading8" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Visa fees depend on the visa category and applicable
                            consular charges. Please contact the Consulate for
                            the latest fee schedule and approved payment
                            instructions before making any payment.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 9 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="0.9s">
                <h2 class="accordion-header" id="heading9">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse9"
                            aria-expanded="false"
                            aria-controls="collapse9">
                        Can I apply for a visa on behalf of another person?
                    </button>
                </h2>
                <div id="collapse9" class="accordion-collapse collapse"
                     aria-labelledby="heading9" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            Application submission procedures may vary depending
                            on the visa category. Please contact the Consulate
                            to confirm whether applications can be submitted
                            through an authorised representative or require
                            the applicant's personal attendance.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 10 -->
            <div class="accordion-item wow fadeInUp" data-wow-delay="1s">
                <h2 class="accordion-header" id="heading10">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse10"
                            aria-expanded="false"
                            aria-controls="collapse10">
                        How can I contact the Consulate for visa assistance?
                    </button>
                </h2>
                <div id="collapse10" class="accordion-collapse collapse"
                     aria-labelledby="heading10" data-bs-parent="#faqaccordion">
                    <div class="accordion-body">
                        <p>
                            For assistance with visa applications, documentation
                            and travel requirements, please contact the
                            Consulate of the Republic of Côte d’Ivoire in
                            The Gambia through its official contact channels.
                        </p>
                        <p>
                            You can visit our Contact Us page for further
                            information and assistance.
                        </p>
                    </div>
                </div>
            </div>

        </div>
        <!-- FAQ Accordion End -->
    </div>

</div>