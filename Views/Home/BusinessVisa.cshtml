
@using Ivory_Coast.ViewModels
@model HomeViewModel

@{
    ViewData["Title"] = "Business Visa";
}

<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Business Visa</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                           <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item"><a href="/Services/Visa-Travel-Information">Visa &amp; Travel Information</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Business Visa</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="our-scrolling-ticker customer-benefit-ticker">
    <div class="scrolling-ticker-box">
        <div class="scrolling-content">
            <span><img src="~/images/asterisk-icon.svg" alt="">Discover the Beauty and Rich Culture of Côte d'Ivoire</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Experience the Warm Hospitality of the Ivorian People</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Explore Abidjan, Beautiful Beaches and Scenic Landscapes</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Your Next Unforgettable Journey Begins in Côte d'Ivoire</span>
        </div>

        <div class="scrolling-content">
            <span><img src="~/images/asterisk-icon.svg" alt="">Discover the Beauty and Rich Culture of Côte d'Ivoire</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Experience the Warm Hospitality of the Ivorian People</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Explore Abidjan, Beautiful Beaches and Scenic Landscapes</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Your Next Unforgettable Journey Begins in Côte d'Ivoire</span>
        </div>
    </div>
</div>
<!-- Page Service Single Start -->
<div class="page-service-single">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- Service Sidebar Start -->
                <partial name="_VisaSideBar" />
                <!-- Service Sidebar End -->
            </div>

            <div class="col-lg-8">
                <!-- Service Single Content Start -->
                <div class="service-single-content">

                    <!-- Service Feature Image Start -->
                    <div class="service-feature-image">
                        <figure class="image-anime reveal">
                            <img src="/img/visa/business.jpg" alt="Business professionals meeting in Côte d’Ivoire">
                        </figure>
                    </div>
                    <!-- Service Feature Image End -->
                    <!-- Service Entry Start -->
                    <div class="service-entry">
                        <p class="wow fadeInUp">
                            Côte d’Ivoire is an important destination for international
                            trade, investment, and commercial partnerships in West Africa.
                            Individuals travelling to the country for business meetings,
                            conferences, trade exhibitions, investment opportunities, or
                            professional engagements should familiarise themselves with
                            the applicable visa requirements and entry procedures before
                            making travel arrangements.
                        </p>

                        <p class="wow fadeInUp" data-wow-delay="0.1s">
                            The Honorary Consulate of the Republic of Côte d’Ivoire in
                            The Gambia provides general information and guidance to
                            Gambian business travellers and other individuals planning
                            commercial or professional visits to Côte d’Ivoire.
                        </p>

                        <!-- Service Entry List Image Start -->
                        <div class="service-entry-list-image">

                            <div class="service-feature-image col-lg-6">
                                <figure class="image-anime reveal">
                                    <img src="/img/visa/business1.jpg" alt="Business meeting and commercial discussions">
                                </figure>
                            </div>

                            <!-- Service Entry List Start -->
                            <div class="service-entry-list wow fadeInUp col-lg-6" data-wow-delay="0.2s">
                                <ul>
                                    <li>Information on business visa requirements and application procedures</li>
                                    <li>Guidance on supporting documents for business travel</li>
                                    <li>Information for attending conferences, meetings, and trade events</li>
                                    <li>General guidance for investors and business professionals</li>
                                    <li>Assistance with business-related consular enquiries</li>
                                </ul>
                            </div>
                            <!-- Service Entry List End -->

                        </div>
                        <!-- Service Entry List Image End -->

                        <p class="wow fadeInUp">
                            Business travellers should ensure that their intended
                            activities are covered by the appropriate visa or entry
                            authorisation. Requirements may vary according to nationality
                            and the nature of the visit. Applicants are encouraged to
                            confirm the latest requirements with the relevant Ivorian
                            immigration or diplomatic authorities before travelling.
                        </p>
                    </div>
                    <!-- Service Entry End -->

                </div>
                <partial name="_VisaInformation" />
            </div>
        </div>
    </div>
</div>
 