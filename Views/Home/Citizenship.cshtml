
@using Ivory_Coast.ViewModels
@model HomeViewModel

@{
    ViewData["Title"] = "Citizenship & Nationality";
}

<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Citizenship &amp; Nationality</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                           <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Services">Services</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Citizenship &amp; Nationality</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Service Single Start -->
<div class="page-service-single">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- Service Sidebar Start -->
                <partial name="_SideBar" />
                <!-- Service Sidebar End -->
            </div>

            <div class="col-lg-8">
                <!-- Service Single Content Start -->
                <div class="service-single-content">

                    <!-- Service Feature Image Start -->
                    <div class="service-feature-image">
                        <figure class="image-anime reveal">
                            <img src="/img/citenzen.jpg" alt="Republic of Côte d’Ivoire national identity">
                        </figure>
                    </div>
                    <!-- Service Feature Image End -->
                    <!-- Service Entry Start -->
                    <div class="service-entry">
                        <p class="wow fadeInUp">
                            Citizenship and nationality matters are important for
                            individuals seeking to establish, confirm, or maintain
                            their legal connection with the Republic of Côte d’Ivoire.
                            These matters may involve questions relating to nationality
                            by descent, citizenship documentation, recognition of
                            Ivorian nationality, and other nationality-related procedures.
                        </p>

                        <p class="wow fadeInUp" data-wow-delay="0.1s">
                            The Honorary Consulate of the Republic of Côte d’Ivoire
                            in The Gambia provides general information and guidance
                            to individuals making enquiries about Ivorian citizenship
                            and nationality. The Consulate can help direct applicants
                            towards the appropriate authorities and provide information
                            about relevant procedures and supporting documentation.
                        </p>

                        <!-- Service Entry List Image Start -->
                        <div class="service-entry-list-image">

                            <div class="service-feature-image col-lg-6">
                                <figure class="image-anime reveal">
                                    <img src="/img/citenzen.jpg" alt="Citizenship and nationality supporting documents">
                                </figure>
                            </div>

                            <!-- Service Entry List Start -->
                            <div class="service-entry-list wow fadeInUp col-lg-6" data-wow-delay="0.2s">
                                <ul>
                                    <li>General information on Ivorian citizenship and nationality</li>
                                    <li>Guidance on nationality by descent and family connections</li>
                                    <li>Information on documents used to establish nationality</li>
                                    <li>Guidance on relevant citizenship and nationality procedures</li>
                                    <li>Assistance with nationality-related consular enquiries</li>
                                </ul>
                            </div>
                            <!-- Service Entry List End -->

                        </div>
                        <!-- Service Entry List Image End -->

                        <p class="wow fadeInUp">
                            Citizenship and nationality matters are governed by
                            Ivorian law and determined by the competent authorities
                            of Côte d’Ivoire. Requirements and procedures depend on
                            individual circumstances. Applicants are encouraged to
                            contact the Consulate for general guidance and confirm
                            the applicable requirements with the relevant Ivorian
                            authorities before submitting any application.
                        </p>
                    </div>
                    <!-- Service Entry End -->

                </div>
                <div class="why-choose-content service-single-why-choose">
                    <!-- Section Title Start -->
                    <div class="section-title">
                        <h3 class="wow fadeInUp">Citizenship &amp; Nationality Information</h3>

                        <h2 class="text-anime-style-3" data-cursor="-opaque">
                            Understanding Ivorian Citizenship and Nationality
                        </h2>

                        <p class="wow fadeInUp" data-wow-delay="0.2s">
                            Whether you are seeking to establish your Ivorian nationality,
                            confirm citizenship through your parents, obtain nationality-related
                            documentation or enquire about citizenship procedures, find general
                            guidance on the relevant requirements and consular assistance
                            available through the Honorary Consulate of the Republic of
                            Côte d’Ivoire in The Gambia.
                        </p>
                    </div>

                    <div style="margin-bottom:30px;" class="why-choose-item-list">

                        <!-- Item 1 -->
                        <div class="why-choose-item wow fadeInUp">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-1.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Nationality by Descent</h3>
                                <p>
                                    General information for individuals with Ivorian parents
                                    or family connections seeking to establish their nationality.
                                </p>
                            </div>
                        </div>

                        <!-- Item 2 -->
                        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.2s">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-2.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Proof of Nationality</h3>
                                <p>
                                    Guidance on documents that may help establish or confirm
                                    Ivorian nationality and citizenship.
                                </p>
                            </div>
                        </div>

                        <!-- Item 3 -->
                        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.4s">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-3.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Citizenship Procedures</h3>
                                <p>
                                    Information on nationality-related applications,
                                    administrative procedures and the relevant authorities.
                                </p>
                            </div>
                        </div>

                        <!-- Item 4 -->
                        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.6s">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-4.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Consular Guidance</h3>
                                <p>
                                    Assistance with nationality enquiries and direction
                                    to the competent authorities in Côte d’Ivoire.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

                <partial name="_ConsularInformationTrim" />
                <div class="our-faqs-section">

                    <!-- Section Title Start -->
                    <div class="section-title">
                        <h3 class="wow fadeInUp">FAQ</h3>
                        <h2 class="text-anime-style-3" data-cursor="-opaque">
                            Frequently Asked Questions
                        </h2>
                    </div>
                    <!-- Section Title End -->
                    <!-- FAQ Accordion Start -->
                    <div class="faq-accordion" id="faqaccordion">

                        <!-- FAQ 1 -->
                        <div class="accordion-item wow fadeInUp">
                            <h2 class="accordion-header" id="heading1">
                                <button class="accordion-button" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse1"
                                        aria-expanded="true"
                                        aria-controls="collapse1">
                                    Who is eligible for Ivorian citizenship?
                                </button>
                            </h2>
                            <div id="collapse1" class="accordion-collapse collapse show"
                                 aria-labelledby="heading1" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Eligibility for Ivorian nationality is determined by
                                        the nationality laws of Côte d’Ivoire. Individuals may
                                        have a claim to Ivorian nationality through their
                                        parentage or other legally recognised circumstances.
                                        Contact the Consulate for general guidance on your
                                        particular situation.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 2 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                            <h2 class="accordion-header" id="heading2">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse2"
                                        aria-expanded="false"
                                        aria-controls="collapse2">
                                    Can I obtain Ivorian nationality if one of my parents is Ivorian?
                                </button>
                            </h2>
                            <div id="collapse2" class="accordion-collapse collapse"
                                 aria-labelledby="heading2" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Having an Ivorian parent may provide a basis for
                                        establishing Ivorian nationality, subject to the
                                        applicable laws and documentation requirements.
                                        You should contact the Consulate for guidance on
                                        the documents needed to establish your family
                                        connection and nationality claim.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 3 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.3s">
                            <h2 class="accordion-header" id="heading3">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse3"
                                        aria-expanded="false"
                                        aria-controls="collapse3">
                                    What documents may be required to prove Ivorian nationality?
                                </button>
                            </h2>
                            <div id="collapse3" class="accordion-collapse collapse"
                                 aria-labelledby="heading3" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Supporting documents may include birth certificates,
                                        parents' nationality documents, identity documents
                                        and other official civil status records. The exact
                                        requirements depend on your circumstances and the
                                        procedure involved. Contact the Consulate for the
                                        applicable document checklist.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 4 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                            <h2 class="accordion-header" id="heading4">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse4"
                                        aria-expanded="false"
                                        aria-controls="collapse4">
                                    How can I confirm whether I am an Ivorian citizen?
                                </button>
                            </h2>
                            <div id="collapse4" class="accordion-collapse collapse"
                                 aria-labelledby="heading4" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        You may need to provide relevant personal and family
                                        records for examination by the competent Ivorian
                                        authorities. The Consulate can provide general
                                        guidance on the appropriate procedure for verifying
                                        your nationality status.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 5 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.5s">
                            <h2 class="accordion-header" id="heading5">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse5"
                                        aria-expanded="false"
                                        aria-controls="collapse5">
                                    Can a child born in The Gambia acquire Ivorian nationality?
                                </button>
                            </h2>
                            <div id="collapse5" class="accordion-collapse collapse"
                                 aria-labelledby="heading5" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        A child born in The Gambia to an Ivorian parent may
                                        have a basis for acquiring or establishing Ivorian
                                        nationality, subject to applicable Ivorian law.
                                        Parents should contact the Consulate for guidance
                                        on the relevant civil registration and nationality
                                        documentation procedures.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 6 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                            <h2 class="accordion-header" id="heading6">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse6"
                                        aria-expanded="false"
                                        aria-controls="collapse6">
                                    Can I apply for Ivorian nationality if I am married to an Ivorian citizen?
                                </button>
                            </h2>
                            <div id="collapse6" class="accordion-collapse collapse"
                                 aria-labelledby="heading6" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Marriage to an Ivorian citizen may be relevant to
                                        certain nationality procedures, but it does not
                                        automatically establish citizenship. Eligibility
                                        and applicable requirements must be assessed under
                                        Ivorian law. Contact the Consulate for general
                                        information on the relevant procedures.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 7 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.7s">
                            <h2 class="accordion-header" id="heading7">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse7"
                                        aria-expanded="false"
                                        aria-controls="collapse7">
                                    Can I hold both Ivorian and another nationality?
                                </button>
                            </h2>
                            <div id="collapse7" class="accordion-collapse collapse"
                                 aria-labelledby="heading7" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Questions concerning dual nationality depend on
                                        the nationality laws of the countries involved.
                                        Individuals with more than one nationality should
                                        seek clarification from the competent authorities
                                        in Côte d’Ivoire and the other country concerned.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 8 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                            <h2 class="accordion-header" id="heading8">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse8"
                                        aria-expanded="false"
                                        aria-controls="collapse8">
                                    How can a foreign national acquire Ivorian citizenship?
                                </button>
                            </h2>
                            <div id="collapse8" class="accordion-collapse collapse"
                                 aria-labelledby="heading8" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Foreign nationals seeking Ivorian citizenship must
                                        meet the conditions established under Ivorian
                                        nationality law. The applicable route and supporting
                                        documentation depend on individual circumstances.
                                        Contact the Consulate for general guidance and
                                        information on the competent authorities.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 9 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.9s">
                            <h2 class="accordion-header" id="heading9">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse9"
                                        aria-expanded="false"
                                        aria-controls="collapse9">
                                    Does the Honorary Consulate issue citizenship certificates?
                                </button>
                            </h2>
                            <div id="collapse9" class="accordion-collapse collapse"
                                 aria-labelledby="heading9" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        The issuance and formal determination of nationality
                                        documents are subject to the authority of the relevant
                                        Ivorian government institutions. The Honorary Consulate
                                        provides general information and guidance on the
                                        appropriate procedures. Please contact the Consulate
                                        to confirm the assistance available for your enquiry.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 10 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="1s">
                            <h2 class="accordion-header" id="heading10">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse10"
                                        aria-expanded="false"
                                        aria-controls="collapse10">
                                    How can I contact the Consulate about citizenship matters?
                                </button>
                            </h2>
                            <div id="collapse10" class="accordion-collapse collapse"
                                 aria-labelledby="heading10" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        You can contact the Honorary Consulate of the Republic
                                        of Côte d’Ivoire in The Gambia through its official
                                        communication channels. Visit our Contact Us page
                                        to submit your enquiry and request guidance on
                                        citizenship and nationality matters.
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- FAQ Accordion End -->
                </div>
            </div>


        </div>
    </div>
</div>
<!-- Page Service Single End -->
<partial name="_Contact" />
