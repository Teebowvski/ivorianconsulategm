@using System.IO
@using System.Text.Json
@using System.Collections.Generic
@using System.Text.Json
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = "Gallery";
}


@{
    var folder = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "Gallery", "images");
    var folder1 = System.IO.Path.Combine(folder, "inauguration");
    var folder2 = System.IO.Path.Combine(folder, "Independence day 2024");

    var images = new[] { folder, folder1, folder2 }
        .Where(Directory.Exists)
        .SelectMany(d => Directory.GetFiles(d))
        .Where(f =>
            f.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
            f.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
            f.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
            f.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
        .Select(f => new
        {
            Name = System.IO.Path.GetFileName(f),
            Rel = System.IO.Path.GetRelativePath(
                       System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "Gallery"),
                       f).Replace('\\', '/')
        })
        .OrderBy(x => x.Rel)
        .ToList();

    // Per-file overrides
    var captions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var captionsPath = System.IO.Path.Combine(folder, "captions.json");
    if (System.IO.File.Exists(captionsPath))
    {
        var parsed = JsonSerializer.Deserialize<Dictionary<string, string>>(
            System.IO.File.ReadAllText(captionsPath));
        if (parsed is not null)
            captions = new Dictionary<string, string>(parsed, StringComparer.OrdinalIgnoreCase);
    }

    // Folder-level captions (fallback when no exact filename match)
    var folderCaptions = new (string Prefix, string Caption)[]
    {
        ("images/inauguration/",          "Côte d'Ivoire consulate inauguration"),
        ("images/Independence day 2024/", "Independence Day 2024"),
    };

    // Helper: exact filename → folder fallback → blank
    string ResolveCaption(string name, string rel)
    {
        if (captions.TryGetValue(name, out var exact)) return exact;
        var hit = folderCaptions
            .FirstOrDefault(x => rel.StartsWith(x.Prefix, StringComparison.OrdinalIgnoreCase));
        return hit.Caption ?? "";
    }
}
