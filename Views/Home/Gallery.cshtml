<section style="padding-top:75px; padding-bottom:40px;" class="gallery_area section_gap">
    <div class="container">
        <div class="section_title text-center"></div>

        <div class="row imageGallery1" id="gallery">
            @foreach (var image in images)
            {
                var url = Url.Content("~/Gallery/" + image.Rel);
                var caption = ResolveCaption(image.Name, image.Rel);

                <div class="col-md-4 gallery_item">
                    <div class="gallery_img">
                        <img class="object-cover w-full" src="@url"
                             alt="@(string.IsNullOrEmpty(caption) ? image.Name : caption)">

                        <div class="hover">
                            <a class="light" href="@url" data-caption="@caption" title="@caption">
                                <i class="fa fa-expand"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
