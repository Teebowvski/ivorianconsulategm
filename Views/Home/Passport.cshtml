
@using Ivory_Coast.ViewModels
@model HomeViewModel

@{
    ViewData["Title"] = "Passport Services";
}

<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Passport Services</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Services">Services</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Passport Services</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Service Single Start -->
<div class="page-service-single">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- Service Sidebar Start -->
                <partial name="_SideBar" />
                <!-- Service Sidebar End -->
            </div>

            <div class="col-lg-8">
                <div class="service-single-content">

                    <!-- Service Feature Image Start -->
                    <div class="service-feature-image">
                        <figure class="image-anime reveal">
                            <img src="/img/application.jpg" alt="Republic of Côte d’Ivoire passport">
                        </figure>
                    </div>
                    <!-- Service Feature Image End -->
                    <!-- Service Entry Start -->
                    <div class="service-entry">
                        <p class="wow fadeInUp">
                            The Honorary Consulate of the Republic of Côte d’Ivoire in
                            The Gambia provides information and general guidance to
                            Ivorian nationals on passport-related matters. This includes
                            enquiries concerning passport applications, renewals,
                            replacements, and the documentation that may be required
                            when dealing with the relevant Ivorian authorities.
                        </p>

                        <p class="wow fadeInUp" data-wow-delay="0.1s">
                            Whether you need information about an expired passport,
                            a lost or damaged travel document, or the process for
                            obtaining a new passport, the Consulate can help direct
                            you to the appropriate channels and provide guidance on
                            relevant consular procedures.
                        </p>

                        <!-- Service Entry List Image Start -->
                        <div class="service-entry-list-image">

                            <div class="service-feature-image col-lg-6">
                                <figure class="image-anime reveal">
                                    <img src="/img/passport.jpg" alt="Passport application documents">
                                </figure>
                            </div>

                            <!-- Service Entry List Start -->
                            <div class="service-entry-list wow fadeInUp col-lg-6" data-wow-delay="0.2s">
                                <ul>
                                    <li>General information on Ivorian passport applications</li>
                                    <li>Guidance on passport renewal procedures</li>
                                    <li>Information on lost, stolen, or damaged passports</li>
                                    <li>Guidance on required identification and supporting documents</li>
                                    <li>Information on relevant consular procedures and authorities</li>
                                </ul>
                            </div>
                            <!-- Service Entry List End -->

                        </div>
                        <!-- Service Entry List Image End -->

                        <p class="wow fadeInUp">
                            Passport application, renewal, and replacement requirements
                            are determined by the competent Ivorian authorities and may
                            vary depending on individual circumstances. Applicants are
                            encouraged to contact the Consulate for guidance and confirm
                            the latest procedures, documentation, and appointment
                            requirements with the appropriate Ivorian authorities.
                        </p>
                    </div>
                    <!-- Service Entry End -->

                </div>

                <div class="why-choose-content service-single-why-choose">
                    <!-- Section Title Start -->
                
                    <div class="section-title">
                        <h3 class="wow fadeInUp">Passport Services Information</h3>

                        <h2 class="text-anime-style-3" data-cursor="-opaque">
                            Passport Guidance and Consular Assistance
                        </h2>

                        <p class="wow fadeInUp" data-wow-delay="0.2s">
                            Whether you are applying for a new passport, renewing an existing
                            one or seeking assistance with a lost or damaged travel document,
                            find relevant information about Ivorian passport procedures and
                            consular assistance available through the Consulate of the
                            Republic of Côte d’Ivoire in The Gambia.
                        </p>
                    </div>
 
                    <div style="margin-bottom:30px;" class="why-choose-item-list">

                        <!-- Item 1 -->
                        <div class="why-choose-item wow fadeInUp">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-1.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Passport Applications</h3>
                                <p>Information and guidance for Ivorian nationals seeking to obtain a new passport.</p>
                            </div>
                        </div>

                        <!-- Item 2 -->
                        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.2s">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-2.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Passport Renewals</h3>
                                <p>Guidance on renewing expired or soon-to-expire Ivorian passports.</p>
                            </div>
                        </div>

                        <!-- Item 3 -->
                        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.4s">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-3.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Lost or Damaged Passports</h3>
                                <p>Information on the procedures to follow when an Ivorian passport is lost, stolen or damaged.</p>
                            </div>
                        </div>

                        <!-- Item 4 -->
                        <div class="why-choose-item wow fadeInUp" data-wow-delay="0.6s">
                            <div class="icon-box">
                                <img src="/images/icon-why-choose-4.svg" alt="">
                            </div>
                            <div class="why-choose-item-content">
                                <h3>Consular Assistance</h3>
                                <p>Assistance with passport-related enquiries, supporting documentation and relevant consular procedures.</p>
                            </div>
                        </div>

                    </div>

                    <partial name="_ConsularInformationTrim" />
      
                    <div class="our-faqs-section">

                        <!-- Section Title Start -->
                        <div class="section-title">
                            <h3 class="wow fadeInUp">FAQ</h3>
                            <h2 class="text-anime-style-3" data-cursor="-opaque">
                                Frequently Asked Questions
                            </h2>
                        </div>
                        <!-- Section Title End -->
                        <!-- FAQ Accordion Start -->
                        <div class="faq-accordion" id="faqaccordion">

                            <!-- FAQ 1 -->
                            <div class="accordion-item wow fadeInUp">
                                <h2 class="accordion-header" id="heading1">
                                    <button class="accordion-button" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse1"
                                            aria-expanded="true"
                                            aria-controls="collapse1">
                                        How can I apply for an Ivorian passport in The Gambia?
                                    </button>
                                </h2>
                                <div id="collapse1" class="accordion-collapse collapse show"
                                     aria-labelledby="heading1" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Ivorian nationals residing in The Gambia should
                                            contact the Consulate for guidance on passport
                                            application procedures, required documentation
                                            and the appropriate submission channels.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 2 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                                <h2 class="accordion-header" id="heading2">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse2"
                                            aria-expanded="false"
                                            aria-controls="collapse2">
                                        What documents are required to apply for a passport?
                                    </button>
                                </h2>
                                <div id="collapse2" class="accordion-collapse collapse"
                                     aria-labelledby="heading2" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Passport applications may require proof of
                                            Ivorian nationality, identification documents,
                                            recent photographs and other supporting
                                            documentation. Requirements may vary depending
                                            on the applicant's circumstances. Contact the
                                            Consulate for the current checklist.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 3 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.3s">
                                <h2 class="accordion-header" id="heading3">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse3"
                                            aria-expanded="false"
                                            aria-controls="collapse3">
                                        How can I renew my expired Ivorian passport?
                                    </button>
                                </h2>
                                <div id="collapse3" class="accordion-collapse collapse"
                                     aria-labelledby="heading3" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Ivorian nationals with expired or soon-to-expire
                                            passports should contact the Consulate for
                                            information about renewal procedures, required
                                            supporting documents and the appropriate
                                            application channels.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 4 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                                <h2 class="accordion-header" id="heading4">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse4"
                                            aria-expanded="false"
                                            aria-controls="collapse4">
                                        What should I do if my passport is lost or stolen?
                                    </button>
                                </h2>
                                <div id="collapse4" class="accordion-collapse collapse"
                                     aria-labelledby="heading4" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            If your passport is lost or stolen, report the
                                            incident to the appropriate local authorities
                                            and obtain a police report where applicable.
                                            Contact the Consulate promptly for guidance on
                                            the necessary documentation and available
                                            procedures for obtaining replacement travel
                                            documentation.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 5 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.5s">
                                <h2 class="accordion-header" id="heading5">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse5"
                                            aria-expanded="false"
                                            aria-controls="collapse5">
                                        Can I replace a damaged passport?
                                    </button>
                                </h2>
                                <div id="collapse5" class="accordion-collapse collapse"
                                     aria-labelledby="heading5" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Yes, damaged passports may require replacement.
                                            Contact the Consulate for guidance on the
                                            applicable procedure and the documents needed
                                            to support your request.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 6 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                                <h2 class="accordion-header" id="heading6">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse6"
                                            aria-expanded="false"
                                            aria-controls="collapse6">
                                        How long does passport processing take?
                                    </button>
                                </h2>
                                <div id="collapse6" class="accordion-collapse collapse"
                                     aria-labelledby="heading6" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Processing times may vary depending on the
                                            application type, verification requirements
                                            and procedures of the competent Ivorian
                                            authorities. Contact the Consulate for
                                            current processing information.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 7 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.7s">
                                <h2 class="accordion-header" id="heading7">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse7"
                                            aria-expanded="false"
                                            aria-controls="collapse7">
                                        Can I apply for a passport for my child?
                                    </button>
                                </h2>
                                <div id="collapse7" class="accordion-collapse collapse"
                                     aria-labelledby="heading7" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Passport applications for minors are subject
                                            to specific requirements, which may include
                                            birth certificates and parental or legal
                                            guardian documentation. Contact the Consulate
                                            for guidance on the applicable requirements.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 8 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                                <h2 class="accordion-header" id="heading8">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse8"
                                            aria-expanded="false"
                                            aria-controls="collapse8">
                                        How much does an Ivorian passport cost?
                                    </button>
                                </h2>
                                <div id="collapse8" class="accordion-collapse collapse"
                                     aria-labelledby="heading8" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Passport fees depend on the applicable passport
                                            service and official charges. Contact the
                                            Consulate for the latest fee information and
                                            approved payment instructions before making
                                            any payment.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 9 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.9s">
                                <h2 class="accordion-header" id="heading9">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse9"
                                            aria-expanded="false"
                                            aria-controls="collapse9">
                                        Do I need an appointment for passport services?
                                    </button>
                                </h2>
                                <div id="collapse9" class="accordion-collapse collapse"
                                     aria-labelledby="heading9" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Appointment requirements depend on the type
                                            of passport service requested. Please contact
                                            the Consulate before visiting to confirm
                                            whether an appointment is necessary.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 10 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="1s">
                                <h2 class="accordion-header" id="heading10">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse10"
                                            aria-expanded="false"
                                            aria-controls="collapse10">
                                        How can I contact the Consulate for passport assistance?
                                    </button>
                                </h2>
                                <div id="collapse10" class="accordion-collapse collapse"
                                     aria-labelledby="heading10" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            You can contact the Consulate of the Republic
                                            of Côte d’Ivoire in The Gambia through its
                                            official communication channels for guidance
                                            on passport applications, renewals,
                                            replacements and other consular matters.
                                            Visit our Contact Us page for further details.
                                        </p>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- FAQ Accordion End -->
                    </div>
           

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Page Service Single End -->
<partial name="_Contact" />