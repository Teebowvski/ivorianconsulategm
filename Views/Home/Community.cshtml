<!-- Page Single Post Start -->
<div class="page-single-post">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">

                <!-- Post Featured Image Start -->
                <div class="post-image">
                    <figure class="image-anime reveal">
                        <img src="~/img/logo.jpg"
                        @* style="display: block; object-fit:contain;" *@
                             alt="Honorary Consulate of Côte d'Ivoire">
                    </figure>
                </div>
                <!-- Post Featured Image End -->
                <!-- Post Single Content Start -->
                <div class="post-content">

                    <!-- Post Entry Start -->
                    <div class="post-entry">

                        <p class="wow fadeInUp">
                            The Honorary Consulate of the Republic of Côte d’Ivoire
                            in The Gambia extends its warm greetings to all Ivorian
                            nationals living, working, studying or visiting in
                            The Gambia.
                        </p>

                        <p class="wow fadeInUp" data-wow-delay="0.2s">
                            You are an important part of the longstanding friendship
                            between our two nations. Your presence, contributions
                            and positive engagement help strengthen the bonds of
                            friendship and cooperation between Côte d’Ivoire and
                            The Gambia.
                        </p>

                        <blockquote class="wow fadeInUp" data-wow-delay="0.4s">
                            <p>
                                "Together, we can strengthen the friendship between
                                our two nations while preserving the values, culture
                                and identity that unite us as Ivorians."
                            </p>
                        </blockquote>

                        <p class="wow fadeInUp" data-wow-delay="0.6s">
                            We encourage all members of the Ivorian community to
                            maintain strong community ties, respect the laws and
                            regulations of The Gambia, and contribute positively
                            to the development and well-being of their host country.
                        </p>

                        <h2 class="wow fadeInUp" data-wow-delay="0.8s">
                            Preserving our identity and strengthening our community
                        </h2>

                        <p class="wow fadeInUp" data-wow-delay="1s">
                            As representatives of Côte d’Ivoire abroad, we encourage
                            every Ivorian national to uphold the values and cultural
                            heritage of our country while fostering mutual respect
                            and peaceful coexistence within Gambian society.
                        </p>

                        <ul class="wow fadeInUp" data-wow-delay="1.2s">
                            <li>Promote unity, solidarity and cooperation within the Ivorian community.</li>
                            <li>Respect the laws, customs and regulations of The Gambia.</li>
                            <li>Preserve and celebrate Ivorian culture, traditions and national identity.</li>
                            <li>Contribute positively to the social and economic development of The Gambia.</li>
                            <li>Maintain constructive relationships with other communities and institutions.</li>
                        </ul>

                        <p class="wow fadeInUp" data-wow-delay="0.6s">
                            The Consulate remains committed to providing appropriate
                            information, guidance and assistance to Ivorian nationals
                            within its mandate. We encourage members of the community
                            to stay informed and contact the Consulate whenever
                            consular guidance or assistance is required.
                        </p>

                    </div>
                    <!-- Post Entry End -->
                    <!-- Post Tag Links Start -->
                    <div class="post-tag-links">
                        <div class="row align-items-center">

                            <div class="col-lg-8">
                                <!-- Post Tags Start -->
                                <div class="post-tags wow fadeInUp" data-wow-delay="0.5s">
                                    <span class="tag-links">
                                        Tags:
                                        <a href="#">Ivorian Community</a>
                                        <a href="#">Consular Services</a>
                                        <a href="#">Community Relations</a>
                                    </span>
                                </div>
                                <!-- Post Tags End -->
                            </div>

                            <div class="col-lg-4">
                                <!-- Post Social Links Start -->
                     
                                <!-- Post Social Links End -->
                            </div>

                        </div>
                    </div>
                    <!-- Post Tag Links End -->

                </div>
                <!-- Post Single Content End -->

            </div>
        </div>
    </div>
</div>
<!-- Page Single Post End -->