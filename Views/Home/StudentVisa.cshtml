
@using Ivory_Coast.ViewModels
@model HomeViewModel

@{
    ViewData["Title"] = "Student Visa";
}

<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Student Visa</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                           <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item"><a href="/Services/Visa-Travel-Information">Visa &amp; Travel Information</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Student Visa</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="our-scrolling-ticker customer-benefit-ticker">
    <div class="scrolling-ticker-box">
        <div class="scrolling-content">
            <span><img src="~/images/asterisk-icon.svg" alt="">Discover the Beauty and Rich Culture of Côte d'Ivoire</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Experience the Warm Hospitality of the Ivorian People</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Explore Abidjan, Beautiful Beaches and Scenic Landscapes</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Your Next Unforgettable Journey Begins in Côte d'Ivoire</span>
        </div>

        <div class="scrolling-content">
            <span><img src="~/images/asterisk-icon.svg" alt="">Discover the Beauty and Rich Culture of Côte d'Ivoire</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Experience the Warm Hospitality of the Ivorian People</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Explore Abidjan, Beautiful Beaches and Scenic Landscapes</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Your Next Unforgettable Journey Begins in Côte d'Ivoire</span>
        </div>
    </div>
</div>
<!-- Page Service Single Start -->
<div class="page-service-single">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- Service Sidebar Start -->
                <partial name="_VisaSideBar" />
                <!-- Service Sidebar End -->
            </div>

            <div class="col-lg-8">
                <div class="service-single-content">

                    <!-- Service Feature Image Start -->
                    <div class="service-feature-image">
                        <figure class="image-anime reveal">
                            <img src="/img/Visa/int students.jpg" alt="Students preparing to study in Côte d’Ivoire">
                        </figure>
                    </div>
                    <!-- Service Feature Image End -->
                    <!-- Service Entry Start -->
                    <div class="service-entry">
                        <p class="wow fadeInUp">
                            Côte d’Ivoire offers educational opportunities for international
                            students seeking to pursue higher education, professional training,
                            and academic development. Individuals planning to study in the
                            country should familiarise themselves with the relevant visa
                            requirements, admission procedures, and travel documentation
                            before departure.
                        </p>

                        <p class="wow fadeInUp" data-wow-delay="0.1s">
                            The Honorary Consulate of the Republic of Côte d’Ivoire in The
                            Gambia provides general information and guidance to prospective
                            students on relevant consular procedures and travel requirements
                            for their educational journey.
                        </p>

                        <!-- Service Entry List Image Start -->
                        <div class="service-entry-list-image">

                            <div class="service-feature-image col-lg-6">
                                <figure class="image-anime reveal">
                                    <img src="/img/Visa/int student.jpg" alt="Student visa application documents">
                                </figure>
                            </div>

                            <!-- Service Entry List Start -->
                            <div class="service-entry-list wow fadeInUp col-lg-6" data-wow-delay="0.2s">
                                <ul>
                                    <li>Information on student visa requirements and procedures</li>
                                    <li>Guidance on admission letters and supporting academic documents</li>
                                    <li>Information on passport validity and travel documentation</li>
                                    <li>Guidance on relevant consular procedures</li>
                                    <li>General information for students travelling to Côte d’Ivoire</li>
                                </ul>
                            </div>
                            <!-- Service Entry List End -->

                        </div>
                        <!-- Service Entry List Image End -->

                        <p class="wow fadeInUp">
                            Prospective students are encouraged to confirm the latest visa
                            requirements with the appropriate Ivorian immigration and
                            diplomatic authorities before making travel arrangements.
                            Admission to an educational institution does not automatically
                            guarantee visa approval.
                        </p>
                    </div>
                    <!-- Service Entry End -->
                    <partial name="_VisaInformation" />
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Page Service Single End -->
 