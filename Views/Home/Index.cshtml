@using Ivory_Coast.ViewModels
@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}
<style>
    .service-item .icon-box svg {
        position: relative;
        width: 40px;
        height: 40px;
        color: var(--white-color);
        z-index: 1;
        transition: all 0.4s ease-in-out;
    }

    .service-item:hover .icon-box svg,
    .service-item.active .icon-box svg {
        color: var(--accent-color);
    }
</style>
<!-- Hero Section Start -->
<div class="hero hero-bg-image hero-slider-layout">
    <div class="swiper">
        <div class="swiper-wrapper">
            <!-- Hero Slide Start -->
            <div class="swiper-slide">
                <div class="hero-slide">
                    <!-- Slider Image Start -->
                    <div class="hero-slider-image">
                        <img src="~/img/building.jpg" alt="">
                    </div>
                    <!-- Slider Image End -->

                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <!-- Hero Content Start -->
                                <div class="hero-content">
                                    <!-- Section Title Start -->
                                    <div class="section-title dark-section">
                                        <h3 class="wow fadeInUp">Consular representation</h3>
                                        <h1 class="text-anime-style-3" data-cursor="-opaque">Honorary Consulate of the Republic of Côte d'Ivoire</h1>
                                        <p class="wow fadeInUp" data-wow-delay="0.2s">Serving as a bridge between Côte d'Ivoire and The Gambia, the Honorary Consulate provides consular assistance, facilitates access to information, and promotes stronger connections between our communities.</p>
                                    </div>
                                    <!-- Section Title End -->
                                    <!-- Hero Button Start -->
                                    <div class="hero-btn wow fadeInUp" data-wow-delay="0.4s">
                                        <a asp-controller="Home" asp-action="About" class="btn-default">About the Consulate</a>
                                        <a asp-controller="Home" asp-action="Services" class="btn-default">Our Services</a>
                                    </div>
                                    <!-- Hero Button End -->
                                </div>
                                <!-- Hero Content End -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hero Slide End -->
            <!-- Hero Slide Start -->
            <div class="swiper-slide">
                <div class="hero-slide">
                    <!-- Slider Image Start -->
                    <div class="hero-slider-image">
                        <img src="~/img/cote-d-ivoire-abidjan--600659721.jpg" alt="">
                    </div>
                    <!-- Slider Image End -->

                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <!-- Hero Content Start -->
                                <div class="hero-content">
                                    <!-- Section Title Start -->
                                    <div class="section-title dark-section">
                                        <h3 class="wow fadeInUp">Visa & Travel Assistance</h3>
                                        <h1 class="text-anime-style-3" data-cursor="-opaque">Discover Côte d'Ivoire. Let Your Journey Begin.</h1>
                                        <p class="wow fadeInUp" data-wow-delay="0.2s">Whether travelling for business, tourism, education, or personal reasons, access guidance on Ivorian visa requirements, application procedures, and travel documentation through the Consulate.</p>
                                    </div>
                                    <!-- Section Title End -->
                                    <!-- Hero Button Start -->
                                    <div class="hero-btn wow fadeInUp" data-wow-delay="0.4s">
                                        <a asp-controller="Home" asp-action="Visa" class="btn-default">Visa Information</a>
                                        <a asp-controller="Home" asp-action="Contact" class="btn-default">Contact Us</a>
                                    </div>
                                    <!-- Hero Button End -->
                                </div>
                                <!-- Hero Content End -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="hero-slide">
                    <!-- Slider Image Start -->
                    <div class="hero-slider-image">
                        <img src="~/img/Slider1.jpg" alt="">
                    </div>
                    <!-- Slider Image End -->

                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <!-- Hero Content Start -->
                                <div class="hero-content">
                                    <!-- Section Title Start -->
                                    <div class="section-title dark-section">
                                        <h3 class="wow fadeInUp">
                                            Your Consular Point of Contact</h3>
                                            <h1 class="text-anime-style-3" data-cursor="-opaque">Bringing Essential Services and Information Closer to You.</h1>
                                            <p class="wow fadeInUp" data-wow-delay="0.2s">From citizenship enquiries and passport matters to cultural, educational, economic, and general information, the Consulate provides guidance and assistance to individuals seeking connections with Côte d'Ivoire.</p>
                                    </div>
                                    <!-- Section Title End -->
                                    <!-- Hero Button Start -->
                                    <div class="hero-btn wow fadeInUp" data-wow-delay="0.4s">
                                        <a asp-controller="Home" asp-action="ConsularAssistance" class="btn-default">Consular Assistance</a>
                                        <a asp-controller="Home" asp-action="Contact" class="btn-default">Contact Us</a>
                                    </div>
                                    <!-- Hero Button End -->
                                </div>
                                <!-- Hero Content End -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hero Slide End -->
        </div>
        <div class="hero-pagination"></div>
    </div>
</div>
 
 
    <div class="about-us">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <!-- About Us Images Start -->
                    <div class="about-us-images">
                        <div class="about-img-1">
                            <figure class="image-anime reveal">
                            <img src="~/img/press.jpg" alt="Honorary Consulate of Côte d'Ivoire">
                            </figure>
                        </div>

                        <div class="about-img-2">
                            <figure class="image-anime reveal">
                            <img src="~/img/cut.jpg" alt="Côte d'Ivoire and The Gambia">
                            </figure>
                        </div>

                        <!-- Consulate Highlight Box Start -->
                        <div class="success-rating-box">
                            <div class="Success-rating-content">

                                <div class="flex-cols items-center ">
                                    <h2 class="mx-auto w-full flex-column items-center text-center"><span class="counter">2</span></h2>
                                    <p>Nations, One</p>
                                    <p class="text-center">Vision</p>
                                </div>

                            </div>
                        </div>
                        <!-- Consulate Highlight Box End -->
                    </div>
                    <!-- About Us Images End -->
                </div>

                <div class="col-lg-6">
                    <!-- About Us Content Start -->
                    <div class="about-us-content">

                        <div class="section-title">
                            <h3 class="wow fadeInUp">About the Honorary Consulate</h3>

                            <h2 class="text-anime-style-3" data-cursor="-opaque">
                                Strengthening connections between Côte d'Ivoire and The Gambia.
                            </h2>

                            <p class="wow fadeInUp" data-wow-delay="0.2s">
                                The Honorary Consulate of the Republic of Côte d'Ivoire
                                in The Gambia serves as a point of contact for individuals,
                                businesses, and institutions seeking consular assistance,
                                information, and engagement with Côte d'Ivoire. Through
                                its services, the Consulate promotes stronger ties and
                                facilitates connections between the two nations.
                            </p>
                        </div>

                        <!-- About Us List Start -->
                        <div class="about-us-list wow fadeInUp" data-wow-delay="0.4s">
                            <ul>
                                <li>Facilitating consular assistance and visa-related enquiries.</li>
                                <li>Promoting economic, cultural, and educational exchange.</li>
                                <li>Supporting Ivorian nationals and fostering international relations.</li>
                            </ul>
                        </div>
                        <!-- About Us List End -->
                        <!-- About Experience Box Start -->
                        <div class="about-experience-box">
                             

                            <div class="about-experience-content">
                                <p>
                                    <strong>Bridging Nations</strong>
                                    Promoting friendship, cooperation, and meaningful
                                    connections between Côte d'Ivoire and The Gambia.
                                </p>
                            </div>
                        </div>
                        <!-- About Experience Box End -->

                        <div class="about-us-btn wow fadeInUp" data-wow-delay="0.6s">
                            <a asp-controller="Home" asp-action="About" class="btn-default">Discover the Consulate</a>
                        </div>

                    </div>
                    <!-- About Us Content End -->
                </div>
            </div>
        </div>
    </div>
    
<!-- About Us Section End -->
<!-- Our Services Section Start -->
  
