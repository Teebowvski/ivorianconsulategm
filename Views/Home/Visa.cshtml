<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Visa & Travel Information</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="services">services</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Visa & Travel Information</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<div class="our-scrolling-ticker customer-benefit-ticker">
    <div class="scrolling-ticker-box">
        <div class="scrolling-content">
            <span><img src="~/images/asterisk-icon.svg" alt="">Discover the Beauty and Rich Culture of Côte d'Ivoire</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Experience the Warm Hospitality of the Ivorian People</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Explore Abidjan, Beautiful Beaches and Scenic Landscapes</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Your Next Unforgettable Journey Begins in Côte d'Ivoire</span>
        </div>

        <div class="scrolling-content">
            <span><img src="~/images/asterisk-icon.svg" alt="">Discover the Beauty and Rich Culture of Côte d'Ivoire</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Experience the Warm Hospitality of the Ivorian People</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Explore Abidjan, Beautiful Beaches and Scenic Landscapes</span>
            <span><img src="~/images/asterisk-icon.svg" alt="">Your Next Unforgettable Journey Begins in Côte d'Ivoire</span>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Service Single Start -->
<div class="page-service-single">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- Service Sidebar Start -->
<partial name="_VisaSideBar"/>
                <!-- Service Sidebar End -->
            </div>

            <div class="col-lg-8">
                <!-- Service Single Content Start -->
                <div class="service-single-content">
                    <!-- Service Feature Image Start -->
                    <div class="service-feature-image">
                        <figure class="image-anime reveal">
                            <img src="/img/visa.jpg" alt="">
                        </figure>
                    </div>
                    <!-- Service Feature Image End -->
                    <!-- Secvice Entry Start -->
                    <div class="service-entry">
                        <p class="wow fadeInUp">
                            The Honorary Consulate of the Republic of Côte d’Ivoire in The Gambia
                            provides visa and travel information to assist individuals planning
                            to visit Côte d’Ivoire. We offer guidance on visa requirements,
                            application procedures, travel documentation, and other essential
                            information to help travellers prepare for their journey with confidence.
                            Our aim is to make access to accurate travel information easier while
                            promoting stronger connections between The Gambia and Côte d’Ivoire.
                        </p>

                        <!-- Service Entry List Image Start -->
                        <div class="service-entry-list-image">
                            <div class="service-feature-image col-lg-6">
                        <figure class="image-anime reveal">
                                    <img src="/img/application.jpg" alt="">
                        </figure>
                    </div>
                            
                            <!-- Service Entry List Start -->
                            <div class="service-entry-list wow fadeInUp col-lg-6" data-wow-delay="0.2s">
                                <ul>
                                    <li>Guidance on visa requirements and application procedures</li>
                                    <li>Information on required travel documents and supporting materials</li>
                                    <li>General travel advice for visitors to Côte d’Ivoire</li>
                                    <li>Information on consular procedures and relevant authorities</li>
                                    <li>Assistance with travel-related enquiries</li>

                                </ul>
                            </div>
                            <!-- Service Entry List End -->
                        </div>
                        <!-- Service Entry List Image End -->
                    </div>
                    <!-- Secvice Entry End -->
                    <!-- Why Choose Content Start -->
                    <!-- Our FAQs Section Start -->

                </div>
                <partial name="_VisaInformation" />
               
             
            </div>
        </div>
    </div>
</div>
<partial name="_Contact" />