@{
    ViewData["Title"] = "Message to Our Gambian Brothers & Partners";
}

<!-- Page Header Start -->
<div class="page-header dark-section parallaxie">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">
                        Message to Our Gambian Brothers & Partners
                    </h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item"><a href="projects.html" class="disable disabled">Press & Events</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Official Statements</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Single Post Start -->
<div class="page-single-post">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">

                <!-- Post Featured Image Start -->
                <div class="post-image">
                    <figure class="image-anime reveal">
                        <img src="~/img/logo.jpg"
                        @* style="display: block; object-fit:contain;" *@
                             alt="Honorary Consulate of Côte d'Ivoire">
                    </figure>
                </div>
                <!-- Post Featured Image End -->
                <!-- Post Single Content Start -->
                <div class="post-content">

                    <!-- Post Entry Start -->
                    <div class="post-entry">

                        <p class="wow fadeInUp">
                            The Republic of Côte d’Ivoire and the Republic of The Gambia
                            share a common African heritage, a spirit of solidarity and
                            a commitment to regional cooperation and sustainable development.
                        </p>

                        <p class="wow fadeInUp" data-wow-delay="0.2s">
                            Our two nations have great opportunities to deepen their
                            longstanding friendship through stronger diplomatic relations,
                            economic cooperation, cultural exchange and mutually beneficial
                            partnerships.
                        </p>

                        <blockquote class="wow fadeInUp" data-wow-delay="0.4s">
                            <p>
                                "Together, let us transform our brotherly friendship into
                                lasting partnerships, shared opportunities and prosperity
                                for the people of Côte d’Ivoire and The Gambia."
                            </p>
                        </blockquote>

                        <p class="wow fadeInUp" data-wow-delay="0.6s">
                            We warmly invite Gambian public institutions, private-sector
                            organisations, investors, entrepreneurs and citizens to engage
                            with their Ivorian counterparts in building stronger connections
                            and exploring opportunities for collaboration.
                        </p>

                        <h2 class="wow fadeInUp" data-wow-delay="0.8s">
                            Building partnerships and shared prosperity
                        </h2>

                        <p class="wow fadeInUp" data-wow-delay="1s">
                            The Consulate encourages meaningful cooperation across key areas
                            that can strengthen bilateral relations and contribute to the
                            development of both countries.
                        </p>

                        <ul class="wow fadeInUp" data-wow-delay="1.2s">
                            <li>Strengthen diplomatic dialogue and institutional cooperation.</li>
                            <li>Promote trade, investment and private-sector partnerships.</li>
                            <li>Encourage collaboration between businesses and entrepreneurs.</li>
                            <li>Expand cultural, educational and tourism exchanges.</li>
                            <li>Support regional integration, peace and sustainable development.</li>
                        </ul>

                        <p class="wow fadeInUp" data-wow-delay="0.6s">
                            The Honorary Consulate remains committed to serving as a bridge
                            between our two nations, encouraging dialogue, facilitating
                            meaningful connections and supporting initiatives that create
                            lasting opportunities. Together, we can build a stronger future
                            founded on friendship, cooperation and shared prosperity.
                        </p>

                    </div>
                    <!-- Post Entry End -->
                    <!-- Post Tag Links Start -->
                    <div class="post-tag-links">
                        <div class="row align-items-center">

                            <div class="col-lg-8">
                                <!-- Post Tags Start -->
                                <div class="post-tags wow fadeInUp" data-wow-delay="0.5s">
                                    <span class="tag-links">
                                        Tags:
                                        <a href="#">Bilateral Relations</a>
                                        <a href="#">Economic Cooperation</a>
                                        <a href="#">Partnerships</a>
                                    </span>
                                </div>
                                <!-- Post Tags End -->
                            </div>

                            <div class="col-lg-4">
                                <!-- Post Social Links Start -->
                     
                                <!-- Post Social Links End -->
                            </div>

                        </div>
                    </div>
                    <!-- Post Tag Links End -->

                </div>
                <!-- Post Single Content End -->

            </div>
        </div>
    </div>
</div>
<!-- Page Single Post End -->