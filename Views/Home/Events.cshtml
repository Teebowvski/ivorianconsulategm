@{
    ViewData["Title"] = "Events";
}

<!-- Page Header Start -->
<div class="page-header bg-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Events</h1>
                    <nav class="wow fadeInUp" data-wow-delay="0.25s">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item"><a href="#" class="disable disabled">Press & Events</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Events</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Blog Start -->
<div class="page-coaching">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-6">
                <!-- Coaching Item Start -->
                <div class="coaching-item wow fadeInUp">
                    <!-- Coaching Featured Image Start-->
                    <div class="coaching-featured-image">
                        <a asp-controller="Home" asp-action="CAN" data-cursor-text="View">
                            <figure class="image-anime">
                                <img src="~/img/Events/a08eced8-dc2d-41b8-b96e-12abdfc2d0a8.jpg" alt="">
                            </figure>
                        </a>
                    </div>
 
                    <div class="coaching-item-body">
               
                        <div class="coaching-item-content">
                          <h2>
    <a href="coaching-single.html">
        AFCON 2027 Qualifier: Gambia vs Ivory Coast
        @(DateTime.Today == new DateTime(2026, 11, 12) ? "Today" : "12 Nov, 2026")
    </a>
</h2>
                        </div>
               
                        <div class="coaching-item-btn">
                            <a asp-controller="Home" asp-action="CAN" class="readmore-btn">read more</a>
                        </div>
                  
                    </div>
            
                </div>
    
            </div>
 
            </div>

            <div class="col-lg-12">
                <!-- Page Pagination Start -->
                <div class="page-pagination wow fadeInUp" data-wow-delay="1.2s">
                    <ul class="pagination">
                        <li><a href="#"><i class="fa-solid fa-angle-left"></i></a></li>
                        <li class="active"><a href="#">1</a></li>
 
                        <li><a href="#"><i class="fa-solid fa-angle-right"></i></a></li>
                    </ul>
                </div>
                <!-- Page Pagination End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Blog End -->