
@using Ivory_Coast.ViewModels
@model HomeViewModel

@{
    ViewData["Title"] = "Consular Assistance";
}

<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Consular Assistance</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Services">Services</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Consular Assistance</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Service Single Start -->
<div class="page-service-single">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- Service Sidebar Start -->
                <partial name="_SideBar" />
                <!-- Service Sidebar End -->
            </div>

            <div class="col-lg-8">
                <!-- Service Single Content Start -->
                <div class="service-single-content">

                    <!-- Service Feature Image Start -->
                    <div class="service-feature-image">
                        <figure class="image-anime reveal">
                            <img src="/img/Consular1.jpg" alt="Consular assistance and support">
                        </figure>
                    </div>
                    <!-- Service Feature Image End -->
                    <!-- Service Entry Start -->
                    <div class="service-entry">
                        <p class="wow fadeInUp">
                            The Honorary Consulate of the Republic of Côte d’Ivoire in
                            The Gambia provides consular information, guidance, and
                            assistance to Ivorian nationals and other individuals
                            seeking support on matters relating to Côte d’Ivoire.
                            Our aim is to facilitate access to relevant consular
                            information and help individuals understand the
                            appropriate procedures when dealing with consular matters.
                        </p>

                        <p class="wow fadeInUp" data-wow-delay="0.1s">
                            Whether you require information about official documents,
                            assistance with an urgent consular enquiry, or guidance
                            on administrative procedures, the Consulate serves as a
                            point of contact to help direct enquiries to the
                            appropriate Ivorian authorities.
                        </p>

                        <!-- Service Entry List Image Start -->
                        <div class="service-entry-list-image">

                            <div class="service-feature-image col-lg-6">
                                <figure class="image-anime reveal">
                                    <img src="/img/Consular.jpg" alt="Consular support and administrative assistance">
                                </figure>
                            </div>

                            <!-- Service Entry List Start -->
                            <div class="service-entry-list wow fadeInUp col-lg-6" data-wow-delay="0.2s">
                                <ul>
                                    <li>General consular information and guidance</li>
                                    <li>Assistance with enquiries concerning official documents</li>
                                    <li>Guidance on passport and nationality-related matters</li>
                                    <li>Information and direction for urgent consular enquiries</li>
                                    <li>Guidance on relevant administrative and consular procedures</li>
                                </ul>
                            </div>
                            <!-- Service Entry List End -->

                        </div>
                        <!-- Service Entry List Image End -->

                        <p class="wow fadeInUp">
                            The nature of assistance available depends on the
                            circumstances of each enquiry and the authority of the
                            Consulate. Certain matters may require referral to the
                            Embassy, relevant government departments, or competent
                            authorities in Côte d’Ivoire. Individuals requiring
                            assistance are encouraged to contact the Consulate
                            directly for further information and guidance.
                        </p>
                    </div>

                    <div class="why-choose-content service-single-why-choose">
                        <!-- Section Title Start -->
                        <div class="section-title">
                            <h3 class="wow fadeInUp">Consular Assistance Information</h3>

                            <h2 class="text-anime-style-3" data-cursor="-opaque">
                                Support, Guidance and Assistance Abroad
                            </h2>

                            <p class="wow fadeInUp" data-wow-delay="0.2s">
                                Whether you require assistance with personal documentation,
                                need guidance during an emergency, or have questions about
                                consular procedures, the Honorary Consulate of the Republic
                                of Côte d’Ivoire in The Gambia provides information, guidance
                                and appropriate referrals to help address your concerns.
                            </p>
                        </div>

                        <div style="margin-bottom:30px;" class="why-choose-item-list">

                            <!-- Item 1 -->
                            <div class="why-choose-item wow fadeInUp">
                                <div class="icon-box">
                                    <img src="/images/icon-why-choose-1.svg" alt="">
                                </div>
                                <div class="why-choose-item-content">
                                    <h3>Assistance to Ivorian Nationals</h3>
                                    <p>
                                        General guidance and support for Ivorian citizens
                                        residing in, visiting or transiting through The Gambia.
                                    </p>
                                </div>
                            </div>

                            <!-- Item 2 -->
                            <div class="why-choose-item wow fadeInUp" data-wow-delay="0.2s">
                                <div class="icon-box">
                                    <img src="/images/icon-why-choose-2.svg" alt="">
                                </div>
                                <div class="why-choose-item-content">
                                    <h3>Emergency Guidance</h3>
                                    <p>
                                        Guidance and appropriate referrals in cases involving
                                        emergencies, detention, accidents or other urgent concerns.
                                    </p>
                                </div>
                            </div>

                            <!-- Item 3 -->
                            <div class="why-choose-item wow fadeInUp" data-wow-delay="0.4s">
                                <div class="icon-box">
                                    <img src="/images/icon-why-choose-3.svg" alt="">
                                </div>
                                <div class="why-choose-item-content">
                                    <h3>Documentation and Legal Referrals</h3>
                                    <p>
                                        Information on consular documentation and direction
                                        to the appropriate authorities for legal or administrative matters.
                                    </p>
                                </div>
                            </div>

                            <!-- Item 4 -->
                            <div class="why-choose-item wow fadeInUp" data-wow-delay="0.6s">
                                <div class="icon-box">
                                    <img src="/images/icon-why-choose-4.svg" alt="">
                                </div>
                                <div class="why-choose-item-content">
                                    <h3>Consular Enquiries</h3>
                                    <p>
                                        Assistance with general enquiries about consular services,
                                        procedures and available support.
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                    <partial name="_ConsularInformationTrim" />
                    
                    <div class="our-faqs-section">

                        <!-- Section Title Start -->
                        <div class="section-title">
                            <h3 class="wow fadeInUp">FAQ</h3>
                            <h2 class="text-anime-style-3" data-cursor="-opaque">
                                Frequently Asked Questions
                            </h2>
                        </div>
                        <!-- Section Title End -->
                        <!-- FAQ Accordion Start -->
                        <div class="faq-accordion" id="faqaccordion">

                            <!-- FAQ 1 -->
                            <div class="accordion-item wow fadeInUp">
                                <h2 class="accordion-header" id="heading1">
                                    <button class="accordion-button" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse1"
                                            aria-expanded="true"
                                            aria-controls="collapse1">
                                        What is consular assistance?
                                    </button>
                                </h2>
                                <div id="collapse1" class="accordion-collapse collapse show"
                                     aria-labelledby="heading1" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Consular assistance refers to the guidance and support
                                            provided by a consular mission to individuals who require
                                            help with consular matters while abroad. This may include
                                            documentation enquiries, emergency guidance and referrals
                                            to relevant authorities.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 2 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                                <h2 class="accordion-header" id="heading2">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse2"
                                            aria-expanded="false"
                                            aria-controls="collapse2">
                                        Who can request assistance from the Consulate?
                                    </button>
                                </h2>
                                <div id="collapse2" class="accordion-collapse collapse"
                                     aria-labelledby="heading2" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            The Consulate primarily provides consular guidance
                                            to Ivorian nationals in The Gambia. Other individuals
                                            may also contact the Consulate with enquiries relating
                                            to Côte d’Ivoire and its consular services.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 3 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.3s">
                                <h2 class="accordion-header" id="heading3">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse3"
                                            aria-expanded="false"
                                            aria-controls="collapse3">
                                        What should I do if I am involved in an emergency in The Gambia?
                                    </button>
                                </h2>
                                <div id="collapse3" class="accordion-collapse collapse"
                                     aria-labelledby="heading3" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            If you are an Ivorian national facing an emergency,
                                            prioritise your immediate safety and contact the
                                            appropriate local emergency services or authorities.
                                            You may also contact the Consulate for guidance and
                                            information on available consular assistance.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 4 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                                <h2 class="accordion-header" id="heading4">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse4"
                                            aria-expanded="false"
                                            aria-controls="collapse4">
                                        Can the Consulate assist if I am arrested or detained?
                                    </button>
                                </h2>
                                <div id="collapse4" class="accordion-collapse collapse"
                                     aria-labelledby="heading4" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Ivorian nationals who are arrested or detained in
                                            The Gambia may contact the Consulate for guidance
                                            on the appropriate consular procedures. The Consulate
                                            can provide information and referrals where appropriate,
                                            but cannot interfere with local legal proceedings
                                            or override the laws of The Gambia.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 5 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.5s">
                                <h2 class="accordion-header" id="heading5">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse5"
                                            aria-expanded="false"
                                            aria-controls="collapse5">
                                        What assistance is available if I lose my passport?
                                    </button>
                                </h2>
                                <div id="collapse5" class="accordion-collapse collapse"
                                     aria-labelledby="heading5" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            If your Ivorian passport is lost or stolen, report
                                            the incident to the appropriate local authorities
                                            and obtain a police report where applicable. Contact
                                            the Consulate for guidance on the relevant documentation
                                            and procedures for replacement or emergency travel documents.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 6 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                                <h2 class="accordion-header" id="heading6">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse6"
                                            aria-expanded="false"
                                            aria-controls="collapse6">
                                        Can the Consulate help me with legal matters?
                                    </button>
                                </h2>
                                <div id="collapse6" class="accordion-collapse collapse"
                                     aria-labelledby="heading6" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            The Consulate may provide general information and
                                            direct individuals to relevant local authorities
                                            or appropriate legal resources. However, it does
                                            not act as a law firm, provide legal representation
                                            or intervene in judicial proceedings.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 7 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.7s">
                                <h2 class="accordion-header" id="heading7">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse7"
                                            aria-expanded="false"
                                            aria-controls="collapse7">
                                        Can the Consulate assist with the death of an Ivorian national abroad?
                                    </button>
                                </h2>
                                <div id="collapse7" class="accordion-collapse collapse"
                                     aria-labelledby="heading7" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            In the event of the death of an Ivorian national
                                            in The Gambia, family members may contact the
                                            Consulate for guidance on relevant consular
                                            procedures, documentation and referrals to the
                                            appropriate local authorities.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 8 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                                <h2 class="accordion-header" id="heading8">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse8"
                                            aria-expanded="false"
                                            aria-controls="collapse8">
                                        Can I request assistance with official documents?
                                    </button>
                                </h2>
                                <div id="collapse8" class="accordion-collapse collapse"
                                     aria-labelledby="heading8" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            The Consulate can provide general information
                                            about consular documentation and direct you
                                            to the appropriate procedures and authorities.
                                            The type of assistance available depends on
                                            the document and the applicable requirements.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 9 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="0.9s">
                                <h2 class="accordion-header" id="heading9">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse9"
                                            aria-expanded="false"
                                            aria-controls="collapse9">
                                        Does the Consulate provide financial assistance to nationals?
                                    </button>
                                </h2>
                                <div id="collapse9" class="accordion-collapse collapse"
                                     aria-labelledby="heading9" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            Consular assistance does not automatically include
                                            financial support. The availability of assistance
                                            depends on the circumstances and applicable policies.
                                            Contact the Consulate directly to discuss your situation
                                            and any available guidance.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 10 -->
                            <div class="accordion-item wow fadeInUp" data-wow-delay="1s">
                                <h2 class="accordion-header" id="heading10">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse10"
                                            aria-expanded="false"
                                            aria-controls="collapse10">
                                        How can I request consular assistance?
                                    </button>
                                </h2>
                                <div id="collapse10" class="accordion-collapse collapse"
                                     aria-labelledby="heading10" data-bs-parent="#faqaccordion">
                                    <div class="accordion-body">
                                        <p>
                                            You can contact the Honorary Consulate of the Republic
                                            of Côte d’Ivoire in The Gambia through its official
                                            communication channels. Visit our Contact Us page
                                            and provide a clear description of your enquiry
                                            so that it can be directed appropriately.
                                        </p>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- FAQ Accordion End -->
                    </div>

                </div>
                <!-- Service Single Content End -->
            </div>
        </div>
    </div>
</div>
<partial name="_Contact" />

 