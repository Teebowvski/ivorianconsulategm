<section style="padding-top:75px;" class="gallery_area section_gap">
    <div class="container">
        <div class="section_title text-center">
            @*           <h2 class="title_color">Royal Hotel Gallery</h2>
            <p>Who are in extremely love with eco friendly system.</p> *@
        </div>
        <div class="row imageGallery1" id="gallery">
            @foreach (var image in images)
            {
                var url = Url.Content("~/Gallery/images/Vlogs/" + image);
                var nameNoExt = System.IO.Path.GetFileNameWithoutExtension(image);

                var posterFullPath = System.IO.Path.Combine(Env.WebRootPath,
                    "Gallery", "images", "Vlogs", "posters", nameNoExt + ".jpg");
                var hasPoster = System.IO.File.Exists(posterFullPath);
                var posterUrl = hasPoster
                    ? Url.Content("~/Gallery/images/Vlogs/posters/" + nameNoExt + ".jpg")
                    : "";

                <div class="col-md-4 gallery_item">
                    <div class="gallery_img">
                        <video src="@url"
                               preload="none"
                               controls
                               playsinline
                               muted
                               poster="@posterUrl"
                               class="video-native"></video>
                    </div>
                </div>
            }
            <div class="col-md-4 gallery_item">
                <div class="gallery_img">
                    <iframe src="https://www.youtube.com/embed/SpPUMvFMlnc"
                            title="YouTube video"
                            width="100%" height="100%"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen
                            class="video-native">
                    </iframe>
                </div>
            </div>

            <div class="col-md-4 gallery_item">
                <div class="gallery_img">
                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/Xi69Lb57L90?si=9sAtr3SabpclYneH" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>
    </div>
</section>

