<script>
    $(document).ready(function() {
        $('#figureCarousel').owlCarousel({
            loop: true,           // infinite loop
            margin: 0,            // no gap between items
            nav: true,            // show next/prev arrows
            dots: true,           // show dots
            items: 1,             // ONLY ONE ITEM VISIBLE AT A TIME
            autoplay: false,      // set to true if you want auto-slide
            autoplayTimeout: 4000,
            smartSpeed: 600,
            navText: ['‹', '›'],  // simple arrow symbols
            responsive: {
                0: { items: 1 },
                600: { items: 1 },
                1000: { items: 1 }
            }
        });
    });
</script>