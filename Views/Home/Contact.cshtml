@using Ivory_Coast.ViewModels
@model HomeViewModel

@{
    // Get current route from Context
    var currentPath = Context.Request.Path.ToString();
    var segments = currentPath.TrimStart('/').Split('/', StringSplitOptions.RemoveEmptyEntries);

    // Set Controller and Action properties
    var Controller = segments.Length > 0 ? segments[0] : "Home";
    var Action = segments.Length > 1 ? segments[1] : "Contact";
    var ReturnUrl = currentPath;
}

@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

 
<style>
    .contact-section {
        background-color: #ffffff;
    }

    .contact-container {
        padding: 2rem 1rem;
        margin: 0 auto;
        max-width: 1280px;
    }

    .contact-header {
        padding: 0 1rem;
        margin: 0 auto 2rem;
        max-width: 640px;
        text-align: center;
    }

        .contact-header h2 {
            margin-bottom: 1rem;
            font-size: 2.25rem;
            line-height: 1.1;
            letter-spacing: -0.025em;
            font-weight: 800;
            color: #111827;
        }

        .contact-header p {
            font-weight: 300;
            color: #4b5563;
            font-size: 1.25rem;
        }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
    }

    .contact-form-wrapper {
        grid-column: span 2;
        margin-bottom: 2rem;
    }

    .contact-form {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin: 0 auto;
        max-width: 768px;
    }

        .contact-form label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #111827;
        }

        .contact-form input,
        .contact-form textarea {
            display: block;
            padding: 0.75rem;
            width: 100%;
            font-size: 0.875rem;
            color: #111827;
            background-color: #f9fafb;
            border-radius: 0.5rem;
            border: 1px solid #d1d5db;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            outline: none;
            box-sizing: border-box;
        }

            .contact-form input#email {
                padding: 0.625rem;
            }

        .contact-form textarea {
            padding: 0.625rem;
            resize: vertical;
        }

            .contact-form input:focus,
            .contact-form textarea:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
            }

    .contact-form-full {
        grid-column: span 2;
    }

    .contact-form-terms {
        margin-top: 1rem;
        font-size: 0.875rem;
        color: #6b7280;
    }

        .contact-form-terms a {
            color: #2563eb;
            text-decoration: none;
        }

            .contact-form-terms a:hover {
                text-decoration: underline;
            }

    .contact-form button {
        padding: 0.75rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-align: center;
        color: #ffffff;
        border-radius: 0.5rem;
        background-color: oklch(76.9% 0.188 70.08);
        border: none;
        cursor: pointer;
        width: fit-content;
    }

        .contact-form button:hover {
            background-color: rgb(234, 88, 12);
        }

        .contact-form button:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
        }

    .contact-info-grid {
        display: grid;
        grid-template-columns: 1fr;
        grid-column: span 1;
        gap: 2rem;
        text-align: center;
    }

    .contact-info-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 1rem;
        width: 2.5rem;
        height: 2.5rem;
        background-color: #f3f4f6;
        border-radius: 0.5rem;
    }

        .contact-info-icon svg {
            width: 2.25rem;
            height:2.25rem;
            color: rgb(234, 88, 12);
            
        }

    .contact-info-title {
        margin-bottom: 0.5rem;
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
    }

    .contact-info-text {
        color: #6b7280;
    }

        .contact-info-text.mb-3 {
            margin-bottom: 0.75rem;
        }

    .contact-info-phone {
        font-weight: 600;
        color: rgb(234, 88, 12);
    }

    /* Responsive: sm breakpoint (640px) */
    @@media (min-width: 640px) {
        .contact-container {
            padding: 4rem 1rem;
        }

        .contact-form {
            grid-template-columns: 1fr 1fr;
        }

        .contact-info-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* Responsive: lg breakpoint (1024px) */
    @@media (min-width: 1024px) {
        .contact-container {
            padding: 4rem 1.5rem;
        }

        .contact-header {
            padding: 0 1.5rem;
            margin-bottom: 4rem;
        }

        .contact-grid {
            gap: 2rem;
            grid-template-columns: repeat(3, 1fr);
        }

        .contact-form-wrapper {
            margin-bottom: 0;
        }

        .contact-info-grid {
            grid-template-columns: 1fr;
        }

        .contact-info-icon {
            width: 4rem;
            height: 4rem;
        }

 
    }

 
</style>

<!-- Page Header Start -->
<div class="page-header bg-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Contact us</h1>
                    <nav class="wow fadeInUp" data-wow-delay="0.25s">
                        <ol class="breadcrumb">
                              <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">contact us</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<section class="contact-section">
    <div class="contact-container">
        <div class="contact-header">
            <h2>Contact Us</h2>
            <p>We use an agile approach to test assumptions and connect with the needs of your audience early and often.</p>
        </div>
        <div class="contact-grid">
            <div class="contact-form-wrapper">
                <form asp-controller="Home" asp-action="SendMail" method="post" class="contact-form">
                    <input type="hidden" name="Email.Controller" value="@Controller" />
                    <input type="hidden" name="Email.Action" value="@Action" />
                    <input type="hidden" name="Email.ReturnUrl" value="@ReturnUrl" />
                    <div>
                        <label for="first-name">First Name</label>
                        <input type="text" name="Email.FirstName" id="first-name" placeholder="Bonnie" required>
                    </div>
                    <div>
                        <label for="last-name">Last Name</label>
                        <input type="text" id="last-name" name="Email.LastName" placeholder="Green" required>
                    </div>
                    <div class="contact-form-full">
                        <label for="subject">Subject</label>
                        <input type="text" name="Email.Subject"  id="subject" placeholder="Email subject" required>
                     
                    </div>
                    <div>
                        <label for="email">Your email</label>
                        <input type="email" id="email" name="Email.Email" placeholder="name@flowbite.com" required>
                    </div>
                    <div>
                        <label for="phone-number">Phone Number</label>
                        <input type="tel" name="Email.Phone" id="phone-number" placeholder="+12 345 6789" required>
                    </div>

                    <div class="    " hidden>
                        <label for="FaxNumber">FaxNumber</label>
                        <input type="text" name="Email.FaxNumber"   id="FaxNumber" placeholder="Your FaxNumber">
                 
                    </div>

                    <div class="  " hidden>
                        <label for="Website">Website</label>
                        <input type="text" name="Email.Website"   id="Website" placeholder="Your Website">
                      
                    </div>
                    <div class="contact-form-full">
                        <label for="message">Your message</label>
                        <textarea id="message" rows="6" name="Email.Message" placeholder="Leave a comment..."></textarea>
                        <p class="contact-form-terms">By submitting this form you agree to our <a style=" color:rgb(234, 88, 12) !important;" href="#">terms and conditions</a> and our <a style=" color:rgb(234, 88, 12) !important;" href="#">privacy policy</a> which explains how we may collect, use and disclose your personal information including to third parties.</p>
                    </div>
                    <button type="submit" style="background-color:rgb(234, 88, 12) !important;">Send message</button>
                </form>
            </div>
            <div class="contact-info-grid">
                <div>
                    <div class="contact-info-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"></path></svg>
                    </div>
                    <p class="contact-info-title">Institution information:</p>
                    <p class="contact-info-text">Honorary Consulate of the Republic of Cote D’Ivoire in The Gambia <br></p>
                </div>
                <div>
                    <div class="contact-info-icon">
                        <svg class=" " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                    </div>
                    <p class="contact-info-title">Working Hours:</p>
                    <p class="contact-info-text">
                        Monday - Friday 9:00am - 5:00pm <br>Saturday 9:00am - 1:00pm
                    </p>
                </div>
                <div>
                    <div class="contact-info-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path></svg>
                    </div>
                    <p class="contact-info-title">Address:</p>
                    <p class="contact-info-text">
                        130 Kairaba Avenue, Fajara
                        <br>The Gambia, West Africa
                    </p>
                </div>
                <div>
                    <div class="contact-info-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path></svg>
                    </div>
                    <p class="contact-info-title">Call us:</p>
                    <p class="contact-info-text mb-3">Call us to speak to a member of our team. We are always happy to help.</p>
                        <p class="contact-info-phone">+220 2467777 <br />+220 3427777</p>

                
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white relative isolate overflow-hidden lg:overflow-visible container">

 
        <div class="max-w-7xl mx-auto lg:px-8 px-4 sm:px-6 lg:py-24 py-16">
            <div class="divide-y-2 divide-gray-200">
 

            <!-- Map -->
            <div style="margin-bottom:25px;" class="pb-8">
                <div class="max-w-7xl mx-auto py-16 sm:py-24">
                    <div class="rounded-lg overflow-hidden shadow" style="height: 500px; position: relative;">
                        <div class="embed-map-responsive">
                            <div class="embed-map-container">
                                <iframe class="embed-map-frame"
                                        frameborder="0"
                                        scrolling="yes"
                                        marginheight="0"
                                        marginwidth="0"
                                        src="https://maps.google.com/maps?width=600&height=500&hl=en&q=130%20Kairaba%20Avenue%20Fajara%20Gambia&t=&z=14&ie=UTF8&iwloc=B&output=embed">
                                </iframe>
                            </div>
                        </div>
                        <style>
                                                    .embed-map-responsive {
                                                        position: relative;
                                                        text-align: right;
                                                        width: 100%;
                                                        height: 100%;
                                                    }

                                                    .embed-map-container {
                                                        overflow: hidden;
                                                        background: none !important;
                                                        width: 100%;
                                                        height: 100%;
                                                        position: absolute;
                                                        top: 0;
                                                        left: 0;
                                                    }

                                                    .embed-map-frame {
                                                        width: 100% !important;
                                                        height: 100% !important;
                                                        position: absolute;
                                                        top: 0;
                                                        left: 0;
                                                    }
                        </style>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</section>

                         
