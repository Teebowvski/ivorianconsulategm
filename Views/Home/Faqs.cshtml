@{
    ViewData["Title"] = "FAQ's";

}


<!-- Page Header Start -->
<div class="page-header bg-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Frequently asked question</h1>
                    <nav class="wow fadeInUp" data-wow-delay="0.25s">
                        <ol class="breadcrumb">
                              <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">FAQs</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Faqs Start -->
<div class="page-faqs">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <!-- FAQ Sidebar Start -->
                <div class="faq-sidebar">
                    <partial name="_FaqSidebar"/>
                </div>
            </div>
            <div class="col-lg-8">
               
                    <div class="page-faqs-catagery">

                        <!-- 1. VISA APPLICATION PROCESS -->
                        <div class="page-faq-accordion" id="visa_application_process">
                            <div class="section-title">
                                <h2 class="text-anime-style-3" data-cursor="-opaque">
                                    Visa Application Process
                                </h2>
                            </div>

                            <div class="faq-accordion" id="accordion">

                                <div class="accordion-item wow fadeInUp">
                                    <h2 class="accordion-header" id="heading1">
                                        <button class="accordion-button" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse1"
                                                aria-expanded="true" aria-controls="collapse1">
                                            How do I start my visa application for Côte d’Ivoire?
                                        </button>
                                    </h2>
                                    <div id="collapse1" class="accordion-collapse collapse show"
                                         aria-labelledby="heading1" data-bs-parent="#accordion">
                                        <div class="accordion-body">
                                            <p>
                                                Begin by checking whether you require a visa to enter
                                                Côte d’Ivoire. If you do, consult the official
                                                <a href="https://snedai.com/e-visa/" target="_blank" rel="noopener">
                                                    SNEDAI visa portal
                                                </a>
                                                to identify the appropriate application procedure.
                                                You may also contact the Honorary Consulate in The Gambia
                                                for general guidance on the applicable requirements.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                                    <h2 class="accordion-header" id="heading2">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse2"
                                                aria-expanded="false" aria-controls="collapse2">
                                            Where can I submit my visa application?
                                        </button>
                                    </h2>
                                    <div id="collapse2" class="accordion-collapse collapse"
                                         aria-labelledby="heading2" data-bs-parent="#accordion">
                                        <div class="accordion-body">
                                            <p>
                                                Visa applications are handled through the official
                                                channels designated by the Ivorian authorities.
                                                The SNEDAI portal provides the official online
                                                application process. The appropriate route depends
                                                on the visa type and the applicant's circumstances.
                                                Contact the Consulate to clarify the applicable
                                                procedure for applicants residing in The Gambia.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                                    <h2 class="accordion-header" id="heading3">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse3"
                                                aria-expanded="false" aria-controls="collapse3">
                                            Can I apply for a Côte d’Ivoire visa online?
                                        </button>
                                    </h2>
                                    <div id="collapse3" class="accordion-collapse collapse"
                                         aria-labelledby="heading3" data-bs-parent="#accordion">
                                        <div class="accordion-body">
                                            <p>
                                                Yes. Côte d’Ivoire provides an official online
                                                e-Visa application process through
                                                <a href="https://snedai.com/e-visa/" target="_blank" rel="noopener">
                                                    SNEDAI
                                                </a>.
                                                Applicants complete the required pre-enrolment
                                                information, upload supporting documents and follow
                                                the payment instructions. The applicable process
                                                must be checked before applying.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                                    <h2 class="accordion-header" id="heading4">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse4"
                                                aria-expanded="false" aria-controls="collapse4">
                                            What happens after my online e-Visa application is submitted?
                                        </button>
                                    </h2>
                                    <div id="collapse4" class="accordion-collapse collapse"
                                         aria-labelledby="heading4" data-bs-parent="#accordion">
                                        <div class="accordion-body">
                                            <p>
                                                Following submission and payment, the application
                                                is reviewed by the competent Ivorian authorities.
                                                Applicants receive the outcome through the email
                                                address provided. For the airport e-Visa procedure,
                                                an approved pre-enrolment document must be presented
                                                on arrival in Abidjan for the required biometric
                                                enrolment and visa issuance.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                                    <h2 class="accordion-header" id="heading5">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse5"
                                                aria-expanded="false" aria-controls="collapse5">
                                            Does submitting a visa application guarantee approval?
                                        </button>
                                    </h2>
                                    <div id="collapse5" class="accordion-collapse collapse"
                                         aria-labelledby="heading5" data-bs-parent="#accordion">
                                        <div class="accordion-body">
                                            <p>
                                                No. Submitting an application or making a payment
                                                does not guarantee that a visa will be granted.
                                                Every application is subject to review and approval
                                                by the competent Ivorian authorities.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>


                        <!-- 2. ELIGIBILITY AND REQUIREMENTS -->
                        <div class="faq-accordion page-faq-accordion" id="eligibility_requirements">
                            <div class="section-title">
                                <h2 class="text-anime-style-3" data-cursor="-opaque">
                                    Eligibility &amp; Requirements
                                </h2>
                            </div>

                            <div class="faq-accordion" id="accordion1">

                                <div class="accordion-item wow fadeInUp">
                                    <h2 class="accordion-header" id="heading6">
                                        <button class="accordion-button" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse6"
                                                aria-expanded="true" aria-controls="collapse6">
                                            Who needs a visa to travel to Côte d’Ivoire?
                                        </button>
                                    </h2>
                                    <div id="collapse6" class="accordion-collapse collapse show"
                                         aria-labelledby="heading6" data-bs-parent="#accordion1">
                                        <div class="accordion-body">
                                            <p>
                                                Visa requirements depend on the traveller's
                                                nationality, passport type and applicable
                                                international agreements. Some nationalities
                                                may be exempt from visa requirements, while
                                                others must obtain a visa before travelling.
                                                Check with the relevant Ivorian authorities
                                                before making travel arrangements.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                                    <h2 class="accordion-header" id="heading7">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse7"
                                                aria-expanded="false" aria-controls="collapse7">
                                            What are the basic requirements for a Côte d’Ivoire e-Visa?
                                        </button>
                                    </h2>
                                    <div id="collapse7" class="accordion-collapse collapse"
                                         aria-labelledby="heading7" data-bs-parent="#accordion1">
                                        <div class="accordion-body">
                                            <p>
                                                The official SNEDAI airport e-Visa procedure requires
                                                an eligible ordinary passport valid for at least
                                                six months, a return flight reservation and an
                                                invitation letter or accommodation certificate.
                                                Applicants should check the official portal for
                                                the current eligibility conditions and document
                                                specifications.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                                    <h2 class="accordion-header" id="heading8">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse8"
                                                aria-expanded="false" aria-controls="collapse8">
                                            Do I need a valid passport to apply for a visa?
                                        </button>
                                    </h2>
                                    <div id="collapse8" class="accordion-collapse collapse"
                                         aria-labelledby="heading8" data-bs-parent="#accordion1">
                                        <div class="accordion-body">
                                            <p>
                                                Yes. A valid passport is required. The official
                                                SNEDAI airport e-Visa procedure specifies a minimum
                                                validity of six months. Check the applicable
                                                requirements for your particular visa route
                                                before submitting your application.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                                    <h2 class="accordion-header" id="heading9">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse9"
                                                aria-expanded="false" aria-controls="collapse9">
                                            Can I apply for a visa if I do not meet all the requirements?
                                        </button>
                                    </h2>
                                    <div id="collapse9" class="accordion-collapse collapse"
                                         aria-labelledby="heading9" data-bs-parent="#accordion1">
                                        <div class="accordion-body">
                                            <p>
                                                Applicants are expected to meet the requirements
                                                applicable to their visa category. Missing or
                                                incomplete documentation may result in delays
                                                or refusal. Contact the appropriate visa authority
                                                if you are unsure whether your circumstances
                                                qualify for an exception.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                                    <h2 class="accordion-header" id="heading10">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse10"
                                                aria-expanded="false" aria-controls="collapse10">
                                            Can minors apply for a Côte d’Ivoire visa?
                                        </button>
                                    </h2>
                                    <div id="collapse10" class="accordion-collapse collapse"
                                         aria-labelledby="heading10" data-bs-parent="#accordion1">
                                        <div class="accordion-body">
                                            <p>
                                                Yes. Visa applications may be submitted for minors,
                                                but additional documents can be required, including
                                                a birth certificate, parental authorisation and
                                                identification documents for the parent or legal
                                                guardian. Check the specific requirements before
                                                submitting the application.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>


                        <!-- 3. DOCUMENTATION AND PAPERWORK -->
                        <div class="faq-accordion page-faq-accordion" id="documentation_paperwork">
                            <div class="section-title">
                                <h2 class="text-anime-style-3" data-cursor="-opaque">
                                    Documentation &amp; Paperwork
                                </h2>
                            </div>

                            <div class="faq-accordion" id="accordion2">

                                <div class="accordion-item wow fadeInUp">
                                    <h2 class="accordion-header" id="heading11">
                                        <button class="accordion-button" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse11"
                                                aria-expanded="true" aria-controls="collapse11">
                                            What documents are required for a visa application?
                                        </button>
                                    </h2>
                                    <div id="collapse11" class="accordion-collapse collapse show"
                                         aria-labelledby="heading11" data-bs-parent="#accordion2">
                                        <div class="accordion-body">
                                            <p>
                                                Requirements depend on the visa category and
                                                application route. Documents commonly requested
                                                include a valid passport, passport information
                                                page, recent photograph, return flight reservation
                                                and an invitation letter or accommodation
                                                certificate. Additional documents may be required
                                                depending on the purpose of travel.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                                    <h2 class="accordion-header" id="heading12">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse12"
                                                aria-expanded="false" aria-controls="collapse12">
                                            Do I need an invitation letter for my visa application?
                                        </button>
                                    </h2>
                                    <div id="collapse12" class="accordion-collapse collapse"
                                         aria-labelledby="heading12" data-bs-parent="#accordion2">
                                        <div class="accordion-body">
                                            <p>
                                                An invitation letter or accommodation certificate
                                                is required for the official SNEDAI airport e-Visa
                                                pre-enrolment procedure. Business, private visit
                                                and official mission applications may have
                                                additional supporting-document requirements.
                                                Applicants should follow the instructions for
                                                their specific visa category.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                                    <h2 class="accordion-header" id="heading13">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse13"
                                                aria-expanded="false" aria-controls="collapse13">
                                            Do I need proof of accommodation and a return flight ticket?
                                        </button>
                                    </h2>
                                    <div id="collapse13" class="accordion-collapse collapse"
                                         aria-labelledby="heading13" data-bs-parent="#accordion2">
                                        <div class="accordion-body">
                                            <p>
                                                The official SNEDAI airport e-Visa procedure
                                                requires a return flight reservation and an
                                                invitation letter or accommodation certificate
                                                during pre-enrolment. Other application routes
                                                may have different document requirements.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                                    <h2 class="accordion-header" id="heading14">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse14"
                                                aria-expanded="false" aria-controls="collapse14">
                                            Do I need a yellow fever vaccination certificate?
                                        </button>
                                    </h2>
                                    <div id="collapse14" class="accordion-collapse collapse"
                                         aria-labelledby="heading14" data-bs-parent="#accordion2">
                                        <div class="accordion-body">
                                            <p>
                                                Yes. Côte d’Ivoire's official travel guidance
                                                identifies the international yellow fever
                                                vaccination certificate as a required travel
                                                document. Travellers should carry their valid
                                                international certificate and verify current
                                                health entry requirements before departure.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                                    <h2 class="accordion-header" id="heading15">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse15"
                                                aria-expanded="false" aria-controls="collapse15">
                                            What should I do if I submit incorrect or incomplete documents?
                                        </button>
                                    </h2>
                                    <div id="collapse15" class="accordion-collapse collapse"
                                         aria-labelledby="heading15" data-bs-parent="#accordion2">
                                        <div class="accordion-body">
                                            <p>
                                                Review the application instructions carefully
                                                before submission. If you discover an error or
                                                omission after submitting your application,
                                                consult the official visa portal or the relevant
                                                visa authority for instructions on correcting
                                                or resubmitting the information. Do not assume
                                                that submitted documents can be amended automatically.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>


                        <!-- 4. VISA FEES AND PAYMENTS -->
                        <div class="faq-accordion page-faq-accordion" id="visa_fees_payments">
                            <div class="section-title">
                                <h2 class="text-anime-style-3" data-cursor="-opaque">
                                    Visa Fees &amp; Payments
                                </h2>
                            </div>

                            <div class="faq-accordion" id="accordion3">

                                <div class="accordion-item wow fadeInUp">
                                    <h2 class="accordion-header" id="heading16">
                                        <button class="accordion-button" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse16"
                                                aria-expanded="true" aria-controls="collapse16">
                                            How much does a visa for Côte d’Ivoire cost?
                                        </button>
                                    </h2>
                                    <div id="collapse16" class="accordion-collapse collapse show"
                                         aria-labelledby="heading16" data-bs-parent="#accordion3">
                                        <div class="accordion-body">
                                            <p>
                                                Visa fees depend on the application route and
                                                applicable visa category. The official SNEDAI
                                                portal displays the relevant payment information
                                                during the application process. Always confirm
                                                the current amount through the official portal
                                                before making payment.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                                    <h2 class="accordion-header" id="heading17">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse17"
                                                aria-expanded="false" aria-controls="collapse17">
                                            Are visa application fees refundable if my application is rejected?
                                        </button>
                                    </h2>
                                    <div id="collapse17" class="accordion-collapse collapse"
                                         aria-labelledby="heading17" data-bs-parent="#accordion3">
                                        <div class="accordion-body">
                                            <p>
                                                According to the official SNEDAI e-Visa information,
                                                application fees are non-refundable, including
                                                where an application is refused. Applicants should
                                                review the eligibility requirements and supporting
                                                documents carefully before submitting and paying.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                                    <h2 class="accordion-header" id="heading18">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse18"
                                                aria-expanded="false" aria-controls="collapse18">
                                            How can I pay my visa application fee?
                                        </button>
                                    </h2>
                                    <div id="collapse18" class="accordion-collapse collapse"
                                         aria-labelledby="heading18" data-bs-parent="#accordion3">
                                        <div class="accordion-body">
                                            <p>
                                                Payments for the official airport e-Visa
                                                pre-enrolment are made through the payment
                                                facilities provided on the SNEDAI portal.
                                                The accepted payment methods and instructions
                                                are displayed during the application process.
                                                Use only the official payment channels.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.6s">
                                    <h2 class="accordion-header" id="heading19">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse19"
                                                aria-expanded="false" aria-controls="collapse19">
                                            Are there additional charges apart from the visa fee?
                                        </button>
                                    </h2>
                                    <div id="collapse19" class="accordion-collapse collapse"
                                         aria-labelledby="heading19" data-bs-parent="#accordion3">
                                        <div class="accordion-body">
                                            <p>
                                                Additional charges may apply depending on the
                                                application route, payment method or related
                                                services. Review the payment breakdown shown
                                                on the official application portal before
                                                completing your transaction.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.8s">
                                    <h2 class="accordion-header" id="heading20">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse20"
                                                aria-expanded="false" aria-controls="collapse20">
                                            What should I do if my visa payment is unsuccessful?
                                        </button>
                                    </h2>
                                    <div id="collapse20" class="accordion-collapse collapse"
                                         aria-labelledby="heading20" data-bs-parent="#accordion3">
                                        <div class="accordion-body">
                                            <p>
                                                If your payment is unsuccessful, check your
                                                transaction status and contact your bank or
                                                payment provider if necessary. For technical
                                                problems with the online application or payment
                                                process, consult the support information provided
                                                by SNEDAI. Avoid making repeated payments until
                                                you have confirmed the status of the initial transaction.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    <!--  visa_Information -->
                    <div class="faq-accordion page-faq-accordion" id="visa_Information">
                        <div class="section-title">
                            <h2 class="text-anime-style-3" data-cursor="-opaque">
                                Visa Information
                            </h2>
                        </div>


                        <!-- FAQ 1 -->
                        <div class="accordion-item wow fadeInUp">
                            <h2 class="accordion-header" id="heading1">
                                <button class="accordion-button" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse1"
                                        aria-expanded="true"
                                        aria-controls="collapse1">
                                    Do Gambian citizens need a visa to travel to Côte d’Ivoire?
                                </button>
                            </h2>
                            <div id="collapse1" class="accordion-collapse collapse show"
                                 aria-labelledby="heading1" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        No. Gambian citizens benefit from visa-free travel to
                                        Côte d’Ivoire under ECOWAS free-movement arrangements.
                                        Travellers must carry valid travel documents and comply
                                        with applicable entry requirements.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 2 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                            <h2 class="accordion-header" id="heading2">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse2"
                                        aria-expanded="false"
                                        aria-controls="collapse2">
                                    Who needs a visa to enter Côte d’Ivoire?
                                </button>
                            </h2>
                            <div id="collapse2" class="accordion-collapse collapse"
                                 aria-labelledby="heading2" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Visa requirements depend on the traveller's nationality
                                        and passport type. Foreign nationals residing in The
                                        Gambia should verify their visa eligibility with the
                                        Consulate before making travel arrangements.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 3 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.3s">
                            <h2 class="accordion-header" id="heading3">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse3"
                                        aria-expanded="false"
                                        aria-controls="collapse3">
                                    What types of visas are available for Côte d’Ivoire?
                                </button>
                            </h2>
                            <div id="collapse3" class="accordion-collapse collapse"
                                 aria-labelledby="heading3" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Depending on the purpose and duration of travel,
                                        visa categories may include tourist, business,
                                        transit, private visit, official and long-stay visas.
                                        Applicants should contact the Consulate to identify
                                        the appropriate visa category.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 4 -->
                        <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                            <h2 class="accordion-header" id="heading4">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse4"
                                        aria-expanded="false"
                                        aria-controls="collapse4">
                                    What documents are required for a visa application?
                                </button>
                            </h2>
                            <div id="collapse4" class="accordion-collapse collapse"
                                 aria-labelledby="heading4" data-bs-parent="#faqaccordion">
                                <div class="accordion-body">
                                    <p>
                                        Common supporting documents may include:
